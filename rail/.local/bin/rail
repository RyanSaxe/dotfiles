#!/bin/sh
# Rail control: the in-terminal sidebar (tuis/rail).
#
#   rail on|off|toggle   enable/disable the rail everywhere
#   rail jump <letter>   jump to the agent behind a hint letter
#   rail page up|down    page the rail body when it overflows
#   rail ensure-daemon   start the render daemon if it isn't running
#   rail status          daemon + pane count + enabled flag
#
# The daemon is the ONLY thing that creates rail panes: while the enabled
# flag is set it reconciles every window within a tick. A second spawner
# (hooks, this script) would race it and duplicate panes, so none exists.
set -eu

PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Resolve the repo through this script's own symlink (stow pattern).
SCRIPT_PATH="$(readlink -f "$0")"
REPO_ROOT="${SCRIPT_PATH%/rail/.local/bin/rail}"
RAIL_DIR="$REPO_ROOT/tuis/rail"

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/rail"
ENABLED_FLAG="$STATE/enabled"
PID_FILE="$STATE/daemon.pid"
LOG_FILE="$STATE/daemon.log"

mkdir -p "$STATE"

daemon_running() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

ensure_daemon() {
  daemon_running && return 0
  (cd "$RAIL_DIR" && nohup npx tsx src/daemon.ts >>"$LOG_FILE" 2>&1 &)
}

kill_rail_panes() {
  for pane in $(tmux list-panes -a -F '#{pane_id} #{@rail}' | awk '$2==1 {print $1}'); do
    tmux kill-pane -t "$pane"
  done
}

case "${1:-toggle}" in
on)
  touch "$ENABLED_FLAG"
  ensure_daemon
  ;;
off)
  # Focus mode: no status bar comes back — no chrome at all. Navigation
  # stays on the alt binds; alt+g re-shows the rail.
  rm -f "$ENABLED_FLAG"
  kill_rail_panes
  ;;
toggle)
  if [ -f "$ENABLED_FLAG" ]; then
    "$0" off
  else
    "$0" on
  fi
  ;;
jump)
  # Jump to the agent behind a hint key (alt+a <key> in tmux). Digits
  # are viewer-relative — 1 is the top elsewhere row of the CALLING
  # session's rail — and the literal key `a` is the globally most-urgent
  # agent, current session included. The daemon keeps hints.tsv current:
  # viewing_session <tab> key <tab> target_session <tab> pane_id.
  digit="${2:?usage: rail jump <digit|a>}"
  viewing="$(tmux display-message -p '#{session_name}')"
  hint_line="$(grep "^$viewing	$digit	" "$STATE/hints.tsv" 2>/dev/null | head -1 || true)"
  [ -n "$hint_line" ] || exit 0
  session="$(printf '%s' "$hint_line" | cut -f3)"
  pane="$(printf '%s' "$hint_line" | cut -f4)"
  # The shared jump primitive switches AND syncs the pokemon accent.
  "$HOME/.config/tmux/scripts/goto-pane.sh" "$session" "$pane" "$pane"
  ;;
ensure-daemon)
  ensure_daemon
  ;;
page)
  # Page the rail's body when it overflows (bound to alt+, / alt+. in
  # tmux). The daemon reads this file; the renderer clamps out-of-range.
  direction="${2:?usage: rail page up|down}"
  current="$(cat "$STATE/page" 2>/dev/null || echo 0)"
  case "$direction" in
  up) next=$((current - 1)) ;;
  down) next=$((current + 1)) ;;
  *)
    echo "usage: rail page up|down" >&2
    exit 1
    ;;
  esac
  [ "$next" -lt 0 ] && next=0
  printf '%s' "$next" >"$STATE/page"
  ;;
status)
  if daemon_running; then
    echo "daemon: running (pid $(cat "$PID_FILE"))"
  else
    echo "daemon: not running"
  fi
  if [ -f "$ENABLED_FLAG" ]; then echo "rail: enabled"; else echo "rail: disabled"; fi
  echo "panes: $(tmux list-panes -a -F '#{@rail}' 2>/dev/null | grep -c 1 || true)"
  ;;
*)
  echo "usage: rail on|off|toggle|jump <letter>|page up|down|ensure-daemon|status" >&2
  exit 1
  ;;
esac
