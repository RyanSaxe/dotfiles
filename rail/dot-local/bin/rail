#!/bin/sh
# Rail control: the in-terminal sidebar (tuis/rail).
#
#   rail on|off|toggle   enable/disable the rail everywhere
#   rail jump <letter>   jump to the agent behind a hint letter
#   rail page up|down    page the rail body when it overflows
#   rail tab agents|reviews|tasks
#                       switch the active rail tab
#   rail element <number>
#                       perform the focused tab's numbered element action
#   rail review-dashboard
#                       open the cached GitHub review inbox
#   rail ensure-daemon   start the render daemon if it isn't running
#   rail status          daemon + pane count + enabled flag
#
# The daemon is the ONLY thing that creates rail panes: while the enabled
# flag is set it reconciles every window within a tick. A second spawner
# (hooks, this script) would race it and duplicate panes, so none exists.
set -eu

PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Resolve the repo through this script's own symlink (stow pattern). macOS's
# readlink has no -f flag, so keep this portable across macOS and Linux.
SCRIPT_PATH="$0"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(CDPATH='' cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  case "$LINK_TARGET" in
  /*) SCRIPT_PATH="$LINK_TARGET" ;;
  *) SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="${SCRIPT_PATH%/rail/dot-local/bin/rail}"
RAIL_DIR="$REPO_ROOT/tuis/rail"

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/rail"
ENABLED_FLAG="$STATE/enabled"
PID_FILE="$STATE/daemon.pid"
LOG_FILE="$STATE/daemon.log"

mkdir -p "$STATE"

# The phone channel lives in the repo's untracked .env. Load it here because
# the daemon is usually spawned by tmux's run-shell, which hands over the
# SERVER's environment — frozen at whenever the server started — so an .env
# added later would otherwise never reach it.
if [ -f "$REPO_ROOT/.env" ]; then
  set -a
  # shellcheck source=/dev/null
  . "$REPO_ROOT/.env"
  set +a
fi

# A pid being alive is not enough: a daemon that died ungracefully leaves
# its pidfile behind, and the pid can be reused by an unrelated process —
# trusting it froze rails with no self-recovery. The recorded pid counts
# as running only if its command line is still a rail daemon.
daemon_running() {
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE")"
  kill -0 "$pid" 2>/dev/null || return 1
  ps -o command= -p "$pid" 2>/dev/null | grep -q 'daemon\.ts'
}

ensure_daemon() {
  daemon_running && return 0
  (cd "$RAIL_DIR" && nohup npx tsx src/daemon.ts >>"$LOG_FILE" 2>&1 &)
}

kill_rail_panes() {
  for pane in $(tmux list-panes -a -F '#{pane_id} #{@rail}' | awk '$2==1 {print $1}'); do
    tmux kill-pane -t "$pane"
  done
}

case "${1:-toggle}" in
on)
  touch "$ENABLED_FLAG"
  ensure_daemon
  ;;
off)
  # Focus mode: no status bar comes back — no chrome at all. Navigation
  # stays on the alt binds; alt+g re-shows the rail. The daemon enforces
  # disabled -> no rails too; this sweep is just the instant path.
  rm -f "$ENABLED_FLAG"
  kill_rail_panes
  ;;
toggle)
  if [ -f "$ENABLED_FLAG" ]; then
    "$0" off
  else
    "$0" on
  fi
  ;;
jump)
  # Jump to the agent behind a hint key (alt+space <digit> in tmux). Digits
  # are viewer-relative — 1 is the top elsewhere row of the CALLING
  # session's rail — and the literal key `a` is the globally most-urgent
  # agent, current session included. The daemon keeps hints.tsv current:
  # viewing_session <tab> key <tab> target_session <tab> pane_id.
  digit="${2:?usage: rail jump <digit|a>}"
  viewing="$(tmux display-message -p '#{session_name}')"
  # Literal field comparison, not grep: a session name with regex
  # metacharacters (c++, foo[bar]) must still match its own hint rows.
  hint_line="$(awk -F'\t' -v s="$viewing" -v k="$digit" \
    '$1 == s && $2 == k { print; exit }' "$STATE/hints.tsv" 2>/dev/null || true)"
  [ -n "$hint_line" ] || exit 0
  session="$(printf '%s' "$hint_line" | cut -f3)"
  pane="$(printf '%s' "$hint_line" | cut -f4)"
  # The shared jump primitive switches AND syncs the mascot accent.
  "$HOME/.config/tmux/scripts/goto-pane.sh" "$session" "$pane" "$pane"
  ;;
ensure-daemon)
  ensure_daemon
  ;;
page)
  # Page the rail's body when it overflows (bound to alt+, / alt+. in
  # tmux). The daemon reads this file; the renderer clamps out-of-range.
  direction="${2:?usage: rail page up|down}"
  current="$(cat "$STATE/page" 2>/dev/null || echo 0)"
  case "$direction" in
  up) next=$((current - 1)) ;;
  down) next=$((current + 1)) ;;
  *)
    echo "usage: rail page up|down" >&2
    exit 1
    ;;
  esac
  [ "$next" -lt 0 ] && next=0
  printf '%s' "$next" >"$STATE/page"
  ;;
tab)
  tab="${2:?usage: rail tab agents|reviews|tasks}"
  case "$tab" in
  agents | reviews | tasks) ;;
  review) tab=reviews ;;
  *)
    echo "usage: rail tab agents|reviews|tasks" >&2
    exit 1
    ;;
  esac
  # Pages are not meaningful across surfaces, so changing tabs starts at
  # the top of the new one.
  printf '%s\n' "$tab" >"$STATE/tab"
  printf '0' >"$STATE/page"
  ;;
element)
  number="${2:?usage: rail element <number>}"
  case "$number" in
  1 | 2 | 3 | 4 | 5 | 6 | 7 | 8 | 9) ;;
  *)
    echo "usage: rail element <1-9>" >&2
    exit 1
    ;;
  esac
  cd "$RAIL_DIR"
  exec npx tsx src/tab-element.ts "$number"
  ;;
review-dashboard)
  cd "$RAIL_DIR"
  exec npx tsx src/review-dashboard.ts
  ;;
status)
  if daemon_running; then
    echo "daemon: running (pid $(cat "$PID_FILE"))"
  else
    echo "daemon: not running"
  fi
  if [ -f "$ENABLED_FLAG" ]; then echo "rail: enabled"; else echo "rail: disabled"; fi
  echo "tab: $(cat "$STATE/tab" 2>/dev/null || echo agents)"
  echo "panes: $(tmux list-panes -a -F '#{@rail}' 2>/dev/null | grep -c 1 || true)"
  if [ -n "${AI_HARNESS_NTFY_URL:-}${AGENT_NOTIFICATION_ID:-}" ]; then
    echo "phone: configured"
  else
    echo "phone: NOT configured (set AGENT_NOTIFICATION_ID in $REPO_ROOT/.env)"
  fi
  ;;
*)
  echo "usage: rail on|off|toggle|jump <letter>|page up|down|tab agents|reviews|tasks|element <number>|review-dashboard|ensure-daemon|status" >&2
  exit 1
  ;;
esac
