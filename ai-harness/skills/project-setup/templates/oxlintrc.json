{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Add "react" and "jsx-a11y" for React repos; drop "typescript" and the
  // `typescript/*` rules below for pure JS repos. CLI entrypoints may opt out
  // of `no-console` where stdout/stderr logging is the interface.
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    // oxlint counts `&&`, `||`, `??` and `?:`, so 10 matches Python C901 <= 8.
    "complexity": ["error", 10],
    "max-depth": ["error", 4],
    "max-nested-callbacks": ["error", 3],
    // Pass an options object when a function needs more than three inputs.
    "max-params": ["error", 3],
    "curly": ["error", "multi-line"],
    "import/no-cycle": "error",
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "prefer-const": "error",
    "no-param-reassign": "error",
    "no-nested-ternary": "error",
    "no-else-return": "error",
    "no-lonely-if": "error",
    "unicorn/no-negated-condition": "error",
    // Narrow with type guards or runtime checks instead of casting with `as`.
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    // Use `unknown` and narrow instead of turning off checks with `any`.
    "typescript/no-explicit-any": "error",
    // Handle null and undefined explicitly instead of using `!`.
    "typescript/no-non-null-assertion": "error",
    // Cover every member of a discriminated union in switch statements.
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-misused-promises": "error",
    "typescript/explicit-function-return-type": "error"
  }
}
