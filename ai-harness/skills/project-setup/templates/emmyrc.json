{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    // Use "LuaJIT" for Neovim and LuaJIT projects, or "Lua5.4" for standalone Lua.
    "version": "LuaJIT"
  },
  "diagnostics": {
    "enable": true,
    // Add host globals here when targeting an embedded runtime such as Neovim ("vim").
    "globals": [],
    "severity": {
      // Promote local type, nil-check, control-flow and dead-code diagnostics to errors.
      "need-check-nil": "error",
      "param-type-mismatch": "error",
      "return-type-mismatch": "error",
      "unnecessary-if": "error",
      "assign-type-mismatch": "error",
      "inject-field": "error",
      "redundant-return-value": "error",
      "redundant-parameter": "error",
      "unused": "error",
      "redefined-local": "error",
      "unreachable-code": "error",
      "deprecated": "error"
    }
  }
}
