{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_AGENT_SOURCE=codex bash \"$HOME/.codex/hooks/notify.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AI_AGENT_SOURCE=codex bash \"$HOME/.codex/hooks/notify.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
