{
  "beep": true,
  "hooks": {
    "PermissionRequest": [
      {
        "type": "command",
        "bash": "AI_AGENT_SOURCE=copilot bash \"$HOME/.copilot/hooks/notify.sh\"",
        "timeoutSec": 5
      }
    ],
    "Notification": [
      {
        "type": "command",
        "matcher": "permission_prompt|elicitation_dialog|agent_idle",
        "bash": "AI_AGENT_SOURCE=copilot bash \"$HOME/.copilot/hooks/notify.sh\"",
        "timeoutSec": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "AI_AGENT_SOURCE=copilot bash \"$HOME/.copilot/hooks/notify.sh\"",
        "timeoutSec": 5
      }
    ],
    "ErrorOccurred": [
      {
        "type": "command",
        "bash": "AI_AGENT_SOURCE=copilot bash \"$HOME/.copilot/hooks/notify.sh\"",
        "timeoutSec": 5
      }
    ]
  },
  "renderMarkdown": true,
  "screenReader": false,
  "theme": "auto",
  "model": "claude-opus-4.6",
  "statusLine": {
    "type": "command",
    "command": "$HOME/.copilot/utility-scripts/statusline.sh",
    "padding": 0
  },
  "enabledFeatureFlags": {
    "STATUS_LINE": true
  },
  "footer": {
    "showCustom": true
  }
}
