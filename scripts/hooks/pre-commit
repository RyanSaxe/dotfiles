#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook that runs formatters on staged files
# Only formats files that are staged for commit (not the whole repo)
#
# Supported formatters:
# - stylua: Lua files
# - shfmt: Shell scripts (sh, bash, zsh)
# - prettier: JSON files
# - markdownlint: Markdown files (no line wrapping)
# - ruff: Python files (format + lint fix)
#
# To enable this hook for the dotfiles repo:
#   git config core.hooksPath scripts/hooks

# ──────────────────────────────────────────────────────────────────────────────
# Helper functions
# ──────────────────────────────────────────────────────────────────────────────

# Print colored status messages
info() { printf "\033[1;34m[pre-commit]\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[pre-commit]\033[0m %s\n" "$*"; }
err() { printf "\033[1;31m[pre-commit]\033[0m %s\n" "$*" >&2; }

# Check if a command exists
has_cmd() {
  command -v "$1" &> /dev/null
}

# Get list of staged files matching a pattern
# Uses NUL delimiter for safety with special characters
staged_files() {
  local pattern="$1"
  git diff --cached --name-only --diff-filter=ACM -z | grep -z "$pattern" || true
}

# Format files and re-stage them if changed
format_and_restage() {
  local formatter="$1"
  shift
  local files=("$@")

  if [[ ${#files[@]} -eq 0 ]]; then
    return 0
  fi

  info "Running $formatter on ${#files[@]} file(s)..."

  # Run formatter on each file
  for file in "${files[@]}"; do
    if [[ -f "$file" ]]; then
      "$formatter" "$file"
      git add "$file"
    fi
  done
}

# ──────────────────────────────────────────────────────────────────────────────
# Main formatting logic
# ──────────────────────────────────────────────────────────────────────────────

main() {
  local has_changes=false

  # ── Lua files (stylua) ──────────────────────────────────────────────────────
  if has_cmd stylua; then
    local lua_files=()
    while IFS= read -r -d '' file; do
      lua_files+=("$file")
    done < <(staged_files '\.lua$')

    if [[ ${#lua_files[@]} -gt 0 ]]; then
      has_changes=true
      info "Formatting ${#lua_files[@]} Lua file(s) with stylua..."
      stylua "${lua_files[@]}"
      git add "${lua_files[@]}"
    fi
  else
    warn "stylua not found, skipping Lua formatting"
  fi

  # ── Shell scripts (shfmt) ───────────────────────────────────────────────────
  if has_cmd shfmt; then
    local sh_files=()
    while IFS= read -r -d '' file; do
      sh_files+=("$file")
    done < <(staged_files '\.sh$')

    if [[ ${#sh_files[@]} -gt 0 ]]; then
      has_changes=true
      info "Formatting ${#sh_files[@]} shell file(s) with shfmt..."
      # Use same options as conform.nvim config
      shfmt -i 2 -ci -bn -sr -w "${sh_files[@]}"
      git add "${sh_files[@]}"
    fi
  else
    warn "shfmt not found, skipping shell formatting"
  fi

  # ── JSON files (prettier) ───────────────────────────────────────────────────
  if has_cmd prettier; then
    local json_files=()
    while IFS= read -r -d '' file; do
      json_files+=("$file")
    done < <(staged_files '\.json$')

    if [[ ${#json_files[@]} -gt 0 ]]; then
      has_changes=true
      info "Formatting ${#json_files[@]} JSON file(s) with prettier..."
      prettier --write "${json_files[@]}"
      git add "${json_files[@]}"
    fi
  else
    warn "prettier not found, skipping JSON formatting"
  fi

  # ── Markdown files (markdownlint) ────────────────────────────────────────────
  if has_cmd markdownlint; then
    local md_files=()
    while IFS= read -r -d '' file; do
      md_files+=("$file")
    done < <(staged_files '\.md$')

    if [[ ${#md_files[@]} -gt 0 ]]; then
      has_changes=true
      info "Formatting ${#md_files[@]} Markdown file(s) with markdownlint..."
      # --fix auto-fixes issues, --config uses dotfiles config
      markdownlint --fix --config "$HOME/.config/nvim/.markdownlint.yaml" "${md_files[@]}" || true
      git add "${md_files[@]}"
    fi
  else
    warn "markdownlint not found, skipping Markdown formatting"
  fi

  # ── Python files (ruff) ────────────────────────────────────────────────────────
  if has_cmd ruff; then
    local py_files=()
    while IFS= read -r -d '' file; do
      py_files+=("$file")
    done < <(staged_files '\.py$')

    if [[ ${#py_files[@]} -gt 0 ]]; then
      has_changes=true
      info "Formatting ${#py_files[@]} Python file(s) with ruff..."
      # Format first, then fix lint issues
      ruff format "${py_files[@]}"
      ruff check --fix "${py_files[@]}" || true
      git add "${py_files[@]}"
    fi
  else
    warn "ruff not found, skipping Python formatting"
  fi

  if [[ "$has_changes" == true ]]; then
    info "Formatting complete, changes staged"
  fi
}

main "$@"
