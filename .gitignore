# Working task files and planning discussions for AI agents. Never published;
# committed docs are for humans.
tasks/

# Generated theme output — rendered at runtime into state, never authored
**/generated/

# Tool-writeback state. Design rule 1: these files are written by the tools
# themselves, so tracking them produces permanent churn. (Deliberately
# *.local.* and not *.local — the latter once matched a .local/ source
# directory and silently untracked the theme command.)
*.local.*
.env

# OS + editor noise
.DS_Store
*.swp
*~

# Language caches
__pycache__/
*.py[cod]
.ruff_cache/
node_modules/

# Logs
*.log
