# Working notes for AI agents and planning discussions. Never published;
# committed docs are for humans.
notes/

# Generated theme output — rendered at runtime into state, never authored
**/generated/

# Tool-writeback state. Design rule 1: these files are written by the tools
# themselves, so tracking them produces permanent churn. (Deliberately
# *.local.* and not *.local — the latter also matches stow packages'
# .local/ directories and silently untracked the theme command once.)
*.local.*
.env

# OS + editor noise
.DS_Store
*.swp
*~

# Language caches
__pycache__/
*.py[cod]
.ruff_cache/
node_modules/

# Logs
*.log
