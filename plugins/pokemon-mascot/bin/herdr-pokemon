#!/usr/bin/env -S uv run -q --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pillow"]
# ///
"""Keep one pokemon mascot placed in herdr. One-shot; safe to run anytime.

    herdr-pokemon place     reconcile the mascot with theme state
    herdr-pokemon clear     remove the mascot everywhere

`place` reads the current pokemon from theme state, anchors to the
bottom-right-most pane of the focused tab, and places the normalized sprite.
With no pokemon in state it clears instead, so `place` is the only verb the
event hooks need. Exits quietly when herdr is not running.
"""

from __future__ import annotations

import base64
import contextlib
import io
import json
import os
import socket
import sys
import time
from dataclasses import dataclass
from pathlib import Path

from PIL import Image

SOCKET_PATH = Path.home() / ".config/herdr/herdr.sock"
STATE_DIR = (
    Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "dotfiles"
)
CACHE_DIR = (
    Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "dotfiles/pokemon"
)
GRID_COLS = int(os.environ.get("MASCOT_COLS", "10"))
GRID_ROWS = int(os.environ.get("MASCOT_ROWS", "5"))
LOCK_STALE_SECONDS = 10.0

# ---------------------------------------------------------------- pure logic


@dataclass(frozen=True)
class Pane:
    pane_id: str
    x: int
    y: int
    width: int
    height: int


def anchor_pane(panes: list[Pane]) -> Pane | None:
    """The bottom-right-most pane: greatest bottom edge, then right edge.

    Deterministic and focus-independent, so the mascot never follows the
    cursor or the pane a command happened to run in.
    """
    if not panes:
        return None
    return max(panes, key=lambda p: (p.y + p.height, p.x + p.width))


def placement(pane: Pane, grid_cols: int, grid_rows: int) -> dict[str, int]:
    """Bottom-right corner of the pane, clamped for tiny panes."""
    return {
        "viewport_col": max(0, pane.width - grid_cols - 1),
        "viewport_row": max(0, pane.height - grid_rows - 1),
        "grid_cols": grid_cols,
        "grid_rows": grid_rows,
    }


def normalize(sprite: Image.Image, margin_fraction: float = 0.05) -> Image.Image:
    """Crop to visible content and pad to a square with a small margin.

    PokeAPI sprites are a 96x96 canvas with the creature at arbitrary size
    and offset; without this, each pokemon renders at a different scale and
    some clip at the pane edge.
    """
    rgba = sprite.convert("RGBA")
    content_box = rgba.getchannel("A").getbbox()
    if content_box:
        rgba = rgba.crop(content_box)
    side = max(round(max(rgba.size) * (1 + 2 * margin_fraction)), 1)
    canvas = Image.new("RGBA", (side, side), (0, 0, 0, 0))
    canvas.paste(rgba, ((side - rgba.width) // 2, (side - rgba.height) // 2))
    return canvas


def focused_tab_panes(snapshot: dict) -> list[Pane]:
    tab_id = snapshot.get("focused_tab_id")
    for layout in snapshot.get("layouts", []):
        if layout.get("tab_id") == tab_id:
            return [
                Pane(
                    pane_id=pane["pane_id"],
                    x=pane["rect"]["x"],
                    y=pane["rect"]["y"],
                    width=pane["rect"]["width"],
                    height=pane["rect"]["height"],
                )
                for pane in layout.get("panes", [])
            ]
    return []


# ------------------------------------------------------------------- herdr IO


def request(method: str, params: dict) -> dict:
    with socket.socket(socket.AF_UNIX) as sock:
        sock.connect(str(SOCKET_PATH))
        payload = json.dumps(
            {"id": "pokemon-mascot", "method": method, "params": params}
        )
        sock.sendall((payload + "\n").encode())
        sock.settimeout(5)
        chunks = b""
        while not chunks.endswith(b"\n"):
            data = sock.recv(65536)
            if not data:
                break
            chunks += data
    return json.loads(chunks)


def clear_all(snapshot: dict) -> None:
    for pane in snapshot.get("panes", []):
        request("pane.graphics.clear", {"pane_id": pane["pane_id"]})


def current_pokemon() -> str | None:
    accents = STATE_DIR / "accents.conf"
    if not accents.exists():
        return None
    for line in accents.read_text().splitlines():
        if line.startswith("pokemon="):
            return line.removeprefix("pokemon=").strip() or None
    return None


def mascot_png(name: str) -> bytes | None:
    """Normalized sprite, cached beside the raw sprite pokemon-accents fetched."""
    raw = CACHE_DIR / f"{name}-sprite.png"
    if not raw.exists():
        return None
    normalized = CACHE_DIR / f"{name}-mascot.png"
    if not normalized.exists() or normalized.stat().st_mtime < raw.stat().st_mtime:
        buffer = io.BytesIO()
        normalize(Image.open(raw)).save(buffer, format="PNG")
        normalized.write_bytes(buffer.getvalue())
    return normalized.read_bytes()


def reconcile() -> None:
    snapshot = request("session.snapshot", {})["result"]["snapshot"]
    clear_all(snapshot)

    name = current_pokemon()
    if name is None:
        return
    data = mascot_png(name)
    if data is None:
        return
    pane = anchor_pane(focused_tab_panes(snapshot))
    if pane is None:
        return

    image = Image.open(io.BytesIO(data))
    request(
        "pane.graphics.set",
        {
            "pane_id": pane.pane_id,
            "format": "png",
            "image_width": image.width,
            "image_height": image.height,
            "data_base64": base64.b64encode(data).decode(),
            "placement": placement(pane, GRID_COLS, GRID_ROWS),
        },
    )


# ---------------------------------------------------- debounce and entrypoint


def run_debounced(action) -> None:
    """Coalesce event bursts: concurrent runs mark dirty and exit; the lock
    holder re-runs once per mark. Stale locks (crashed holder) are stolen."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    lock = STATE_DIR / ".mascot.lock"
    dirty = STATE_DIR / ".mascot.dirty"

    try:
        if time.time() - lock.stat().st_mtime > LOCK_STALE_SECONDS:
            lock.unlink(missing_ok=True)
    except FileNotFoundError:
        pass

    try:
        fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
    except FileExistsError:
        dirty.touch()
        return
    os.close(fd)

    try:
        while True:
            dirty.unlink(missing_ok=True)
            action()
            if not dirty.exists():
                break
    finally:
        lock.unlink(missing_ok=True)


def main() -> None:
    if len(sys.argv) != 2 or sys.argv[1] not in ("place", "clear"):
        raise SystemExit("usage: herdr-pokemon place|clear")
    if not SOCKET_PATH.exists():
        return

    if sys.argv[1] == "clear":
        with contextlib.suppress(OSError):
            clear_all(request("session.snapshot", {})["result"]["snapshot"])
        return

    run_debounced(reconcile)


if __name__ == "__main__":
    main()
