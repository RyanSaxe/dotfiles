{
  "type": "group",
  "actions": [
    {
      "key": "t",
      "label": "Terminal (Ghostty)",
      "type": "application",
      "value": "/Applications/Ghostty.app"
    },
    {
      "key": "a",
      "label": "ChatGPT (Web)",
      "type": "command",
      "value": "hs -c 'focusByDomainOrOpen(\"chatgpt.com\", \"https://chatgpt.com\")'"
    },
    {
      "key": "b",
      "label": "Browser",
      "type": "group",
      "actions": [
        {
          "key": "space",
          "label": "Open Chrome",
          "type": "application",
          "value": "/Applications/Google Chrome.app"
        },
        {
          "key": "a",
          "label": "ChatGPT (focus if open)",
          "type": "command",
          "value": "hs -c 'focusByDomainOrOpen(\"chatgpt.com\", \"https://chatgpt.com\")'"
        },
        {
          "key": "y",
          "label": "YouTube (focus if open)",
          "type": "command",
          "value": "hs -c 'focusByDomainOrOpen(\"youtube.com\", \"https://youtube.com\")'"
        },
        {
          "key": "g",
          "label": "GitHub (focus if open)",
          "type": "command",
          "value": "hs -c 'focusByDomainOrOpen(\"github.com\", \"https://github.com\")'"
        }
      ]
    },
    {
      "key": "s",
      "label": "System",
      "type": "group",
      "actions": [
        {
          "key": "l",
          "label": "Lock Screen",
          "type": "command",
          "value": "pmset displaysleepnow"
        },
        {
          "key": "d",
          "label": "Display Settings",
          "type": "command",
          "value": "open 'x-apple.systempreferences:com.apple.preference.displays'"
        }
      ]
    },
  ]
}
