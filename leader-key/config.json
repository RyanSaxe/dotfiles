{
  "type": "group",
  "actions": [
    {
      "key": "s",
      "label": "Spotlight",
      "type": "command",
      "value": "hs -c 'openSpotlight()'"
    },

    {
      "key": "g",
      "label": "Terminal (Ghostty)",
      "type": "application",
      "value": "/Applications/Ghostty.app"
    },

    {
      "key": "o",
      "label": "Outlook",
      "type": "group",
      "actions": [
        {
          "key": "space",
          "label": "Focus / Open Outlook",
          "type": "command",
          "value": "hs -c 'openAppOrWeb(\"Microsoft Outlook\", \"/Applications/Microsoft Outlook.app\", \"https://outlook.office.com\")'"
        },
        {
          "key": "n",
          "label": "New Mail",
          "type": "command",
          "value": "hs -c 'openAppWithKey(\"Microsoft Outlook\", \"/Applications/Microsoft Outlook.app\", \"https://outlook.office.com\", \"n\", {\"cmd\"})'"
        },
        {
          "key": "c",
          "label": "Calendar",
          "type": "command",
          "value": "hs -c 'openAppWithKey(\"Microsoft Outlook\", \"/Applications/Microsoft Outlook.app\", \"https://outlook.office.com\", \"2\", {\"cmd\"})'"
        },
        {
          "key": "s",
          "label": "Search",
          "type": "command",
          "value": "hs -c 'openAppWithKey(\"Microsoft Outlook\", \"/Applications/Microsoft Outlook.app\", \"https://outlook.office.com\", \"f\", {\"cmd\", \"shift\"})'"
        },
        {
          "key": "r",
          "label": "Reply All",
          "type": "command",
          "value": "hs -c 'openAppWithKey(\"Microsoft Outlook\", \"/Applications/Microsoft Outlook.app\", \"https://outlook.office.com\", \"r\", {\"cmd\", \"shift\"})'"
        },
        {
          "key": "f",
          "label": "Forward",
          "type": "command",
          "value": "hs -c 'openAppWithKey(\"Microsoft Outlook\", \"/Applications/Microsoft Outlook.app\", \"https://outlook.office.com\", \"j\", {\"cmd\"})'"
        },
        {
          "key": "M",
          "label": "Mark All as Read",
          "type": "command",
          "value": "hs -c 'outlookMarkAllAsRead()'"
        }
      ]
    },

    {
      "key": "t",
      "label": "Teams",
      "type": "group",
      "actions": [
        {
          "key": "space",
          "label": "Focus / Open Teams",
          "type": "command",
          "value": "hs -c 'openAppOrWeb(\"Microsoft Teams\", \"/Applications/Microsoft Teams.app\", \"https://teams.microsoft.com\")'"
        },
        {
          "key": "c",
          "label": "Calendar",
          "type": "command",
          "value": "hs -c 'openAppWithKey(\"Microsoft Teams\", \"/Applications/Microsoft Teams.app\", \"https://teams.microsoft.com\", \"3\", {\"cmd\"})'"
        },
        {
          "key": "s",
          "label": "Go To",
          "type": "command",
          "value": "hs -c 'openAppWithKey(\"Microsoft Teams\", \"/Applications/Microsoft Teams.app\", \"https://teams.microsoft.com\", \"g\", {\"cmd\"})'"
        },
        {
          "key": "/",
          "label": "Search",
          "type": "command",
          "value": "hs -c 'openAppWithKey(\"Microsoft Teams\", \"/Applications/Microsoft Teams.app\", \"https://teams.microsoft.com\", \"e\", {\"cmd\"})'"
        },
        {
          "key": "m",
          "label": "Meeting: Toggle Mute",
          "type": "command",
          "value": "hs -c 'openAppWithKey(\"Microsoft Teams\", \"/Applications/Microsoft Teams.app\", \"https://teams.microsoft.com\", \"m\", {\"cmd\", \"shift\"})'"
        },
        {
          "key": "v",
          "label": "Meeting: Toggle Video",
          "type": "command",
          "value": "hs -c 'openAppWithKey(\"Microsoft Teams\", \"/Applications/Microsoft Teams.app\", \"https://teams.microsoft.com\", \"o\", {\"cmd\", \"shift\"})'"
        },
        {
          "key": "p",
          "label": "Meeting: Share Screen",
          "type": "command",
          "value": "hs -c 'openAppWithKey(\"Microsoft Teams\", \"/Applications/Microsoft Teams.app\", \"https://teams.microsoft.com\", \"e\", {\"cmd\", \"shift\"})'"
        },
        {
          "key": "u",
          "label": "Command Bar (Availability, etc.)",
          "type": "command",
          "value": "hs -c 'openAppWithKey(\"Microsoft Teams\", \"/Applications/Microsoft Teams.app\", \"https://teams.microsoft.com\", \"e\", {\"cmd\"})'"
        },

        {
          "key": "x",
          "label": "Toggle Camera (OBS Face/Tablet)",
          "type": "command",
          "value": "hs -c 'toggleObsCamera()'"
        },
        {
          "key": "1",
          "label": "Camera: Force Face",
          "type": "command",
          "value": "hs -c 'obsCameraFace()'"
        },
        {
          "key": "2",
          "label": "Camera: Force Tablet",
          "type": "command",
          "value": "hs -c 'obsCameraTablet()'"
        }
      ]
    },

    {
      "key": "a",
      "label": "ChatGPT (Web)",
      "type": "command",
      "value": "hs -c 'focusByDomainOrOpen(\"chatgpt.com\", \"https://chatgpt.com\")'"
    },

    {
      "key": "b",
      "label": "Browser",
      "type": "group",
      "actions": [
        {
          "key": "space",
          "label": "Open Chrome",
          "type": "application",
          "value": "/Applications/Google Chrome.app"
        },
        {
          "key": "a",
          "label": "ChatGPT (focus if open)",
          "type": "command",
          "value": "hs -c 'focusByDomainOrOpen(\"chatgpt.com\", \"https://chatgpt.com\")'"
        },
        {
          "key": "y",
          "label": "YouTube (focus if open)",
          "type": "command",
          "value": "hs -c 'focusByDomainOrOpen(\"youtube.com\", \"https://youtube.com\")'"
        },
        {
          "key": "g",
          "label": "GitHub (focus if open)",
          "type": "command",
          "value": "hs -c 'focusByDomainOrOpen(\"github.com\", \"https://github.com\")'"
        }
      ]
    },

    {
      "key": "w",
      "label": "Window",
      "type": "group",
      "actions": [
        {
          "key": "h",
          "label": "Left Half",
          "type": "command",
          "value": "hs -c 'tileLeft()'"
        },
        {
          "key": "l",
          "label": "Right Half",
          "type": "command",
          "value": "hs -c 'tileRight()'"
        },
        {
          "key": "k",
          "label": "Top Half",
          "type": "command",
          "value": "hs -c 'tileTop()'"
        },
        {
          "key": "j",
          "label": "Bottom Half",
          "type": "command",
          "value": "hs -c 'tileBottom()'"
        },
        {
          "key": "m",
          "label": "Maximize",
          "type": "command",
          "value": "hs -c 'windowMaximize()'"
        },
        {
          "key": "f",
          "label": "Fullscreen",
          "type": "command",
          "value": "hs -c 'windowFullscreen()'"
        }
      ]
    }
  ]
}
