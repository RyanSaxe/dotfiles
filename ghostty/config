# Ghostty configuration.
#
# Theme: Ghostty's terminal palette follows macOS appearance NATIVELY via
# the light:/dark: pair below; `theme dark|light` sets the OS appearance and
# ghostty flips with it. The generated frame shader paints the crust ring
# around the terminal content.
# dotfiles-dark/-light are rendered by the theme system into
# ~/.config/ghostty/themes, so the terminal surface and ANSI 16 speak
# the same palette as every other consumer.
theme = light:dotfiles-light,dark:dotfiles-dark

# Option is Alt: makes the alt layer real for terminal-world keybinds
# (alt+c theme picker, alt+o sessions, workmux binds in Phase 4).
# Cost: option no longer types accented characters (ç, ¡, …).
macos-option-as-alt = true

# ----- misc keybinds ---------------------------------------------------
# tmux owns panes and windows; ghostty-native splits are deliberately
# not configured.

keybind = cmd+r=reload_config
keybind = cmd+o=open_config

# Multiline input for claude code (shift+enter sends ESC+CR).
keybind = shift+enter=text:\x1b\r

# ----- styling ---------------------------------------------------------

font-size = 16

# The frame: 19pt of symmetric padding that the frame shader (below)
# paints in the theme's darkest background tier — a dark chrome around
# every surface. 19pt is the design's spacing unit: two terminal cells at
# font-size 16 (2 × 9.6pt), so the frame, the rail's text inset, and the
# rail→content seam all read as the same gap. The grid starts at (19,19),
# so the sidebar's first cell (the session name) sits exactly there. Must
# stay in sync with FRAME_PT in theme/templates/frame.glsl.tmpl (the
# shader detects the display scale itself). `extend-always` keeps the
# sub-cell remainder in edge colors beneath the shader's ring; balance
# splits it evenly.
# Padding is symmetric: the tmux border column is crust and reads as
# chrome, not as air, so the right side needs no compensating breather.
# extend-always still fills the sub-cell remainder with each edge cell's
# own background beneath the shader's ring.
window-padding-x = 19
window-padding-y = 19
window-padding-color = extend-always
# balance OFF: it redistributes padding evenly across sides, moving the
# sub-cell remainder away from the right/bottom edges where the shader
# expects it.
window-padding-balance = false

# Copying highlighted text needs no shortcut.
copy-on-select = clipboard

# When a TUI (Claude Code fullscreen, etc.) captures the mouse, holding
# SHIFT while dragging forces terminal-native selection — and copy-on-select
# fires. `never` guarantees apps can't claim shift away from the terminal.
mouse-shift-capture = never

# Theme-rendered shaders (from theme/templates/*.glsl.tmpl), copied here
# by the `theme` command, which then signals ghostty (SIGUSR2 = reload) so
# both follow palette/mascot/mode switches with no keypress. The frame
# shader runs last so its ring paints over everything at the edges.
custom-shader = shaders/cursor_trail.glsl
custom-shader = shaders/frame.glsl

# Title bar hidden — window moving is keyboard territory.
macos-titlebar-style = hidden
