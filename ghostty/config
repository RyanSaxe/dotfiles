# custom keybinds

keybind = cmd+shift+l=new_split:right
keybind = cmd+shift+h=new_split:left
keybind = cmd+shift+j=new_split:down
keybind = cmd+shift+k=new_split:up

keybind = cmd+l=goto_split:right
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up

keybind = cmd+shift+up=resize_split:up,10
keybind = cmd+shift+down=resize_split:down,10
keybind = cmd+shift+left=resize_split:left,10
keybind = cmd+shift+right=resize_split:right,10


keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = cmd+r=reload_config
keybind = cmd+o=open_config

# generic styling

font-size = 16
theme = TokyoNight Night
unfocused-split-opacity = 0.8

# specific customizations

## Override background to match Neovim's c.bg_dark from TokyoNight
background = #16161e

## no need to type the shortcut for copying highlighted text
copy-on-select = clipboard

## makes lualine look nicer with generous padding for clarity
window-padding-x = 20
window-padding-y = 20
window-padding-color = background
window-padding-balance = true
## allow multiline for claude code
keybind = shift+enter=text:\x1b\r
## shaders
custom-shader = shaders/cursor_trail_tokyonight.glsl
## exploring options targeted nicer non-full screen experience
## hidden title bar ... since moving windows is done with leader-key shortcuts
macos-titlebar-style = hidden
