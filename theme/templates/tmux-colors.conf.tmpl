# Rendered by `theme` — do not edit; change the template or tokens instead.
# Sourced by tmux.conf at load, and re-sourced by `theme` on every render:
# all tmux styles reference these @variables, so a theme or mascot switch
# recolors the running server with no restart.
set -g @bg "{{bg}}"
set -g @crust "{{crust}}"
set -g @bg_alt "{{bg_alt}}"
set -g @fg "{{fg}}"
set -g @surface "{{bg_highlight}}"
set -g @border "{{border}}"
set -g @dim "{{fg_faint}}"
set -g @accent "{{accent}}"
set -g @notify "{{notify}}"
set -g @warn "{{warn}}"
set -g @info "{{info}}"

# Agent status glyph colors (see workmux config.yaml status_icons), from
# the status_* tokens shared with the rail.
set -g @status_working "{{status_working}}"
set -g @status_waiting "{{status_waiting}}"
set -g @status_done "{{status_done}}"
