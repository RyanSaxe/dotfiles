-- Generated by the theme system; never edit by hand. Consumed by nvim's
-- lua/theme/ — palette keys are raw catppuccin values, roles are the
-- app-agnostic semantic layer, accent and notify carry the mascot.
--
-- The editor spans both layers: the buffer and everything inside it is
-- INNER (the unprefixed tables below), while the chrome that touches a
-- terminal edge — the tab row's fill, sidebars — is OUTER. When the two
-- layers run in different modes, `outer` is the only place to read the
-- other mode's surfaces from.
return {
  mode = "{{inner_mode}}",
  outer = {
    mode = "{{outer_mode}}",
    accent = "{{outer_accent}}",
    notify = "{{outer_notify}}",
    bg = "{{outer_bg}}",
    fg = "{{outer_fg}}",
    fg_muted = "{{outer_fg_muted}}",
    fg_faint = "{{outer_fg_faint}}",
    border = "{{outer_border}}",
    base = "{{outer_base}}",
    mantle = "{{outer_mantle}}",
    crust = "{{outer_crust}}",
    -- The mode letter is painted on outer chrome, so its colors have to
    -- come from the outer palette or they lose contrast when the layers
    -- disagree.
    mauve = "{{outer_mauve}}",
    pink = "{{outer_pink}}",
    blue = "{{outer_blue}}",
    peach = "{{outer_peach}}",
    green = "{{outer_green}}",
    red = "{{outer_red}}",
    yellow = "{{outer_yellow}}",
  },
  accent = "{{inner_accent}}",
  notify = "{{inner_notify}}",
  roles = {
    bg = "{{inner_bg}}",
    bg_alt = "{{inner_bg_alt}}",
    bg_highlight = "{{inner_bg_highlight}}",
    fg = "{{inner_fg}}",
    fg_muted = "{{inner_fg_muted}}",
    fg_faint = "{{inner_fg_faint}}",
    border = "{{inner_border}}",
    warn = "{{inner_warn}}",
    success = "{{inner_success}}",
    info = "{{inner_info}}",
    ghost = "{{inner_ghost}}",
  },
  palette = {
    rosewater = "{{inner_rosewater}}",
    flamingo = "{{inner_flamingo}}",
    pink = "{{inner_pink}}",
    mauve = "{{inner_mauve}}",
    red = "{{inner_red}}",
    maroon = "{{inner_maroon}}",
    peach = "{{inner_peach}}",
    yellow = "{{inner_yellow}}",
    green = "{{inner_green}}",
    teal = "{{inner_teal}}",
    sky = "{{inner_sky}}",
    sapphire = "{{inner_sapphire}}",
    blue = "{{inner_blue}}",
    lavender = "{{inner_lavender}}",
    semantic_add = "{{inner_semantic_add}}",
    semantic_delete = "{{inner_semantic_delete}}",
    semantic_change = "{{inner_semantic_change}}",
    text = "{{inner_text}}",
    subtext1 = "{{inner_subtext1}}",
    subtext0 = "{{inner_subtext0}}",
    overlay2 = "{{inner_overlay2}}",
    overlay1 = "{{inner_overlay1}}",
    overlay0 = "{{inner_overlay0}}",
    surface2 = "{{inner_surface2}}",
    surface1 = "{{inner_surface1}}",
    surface0 = "{{inner_surface0}}",
    base = "{{inner_base}}",
    mantle = "{{inner_mantle}}",
    crust = "{{inner_crust}}",
  },
}
