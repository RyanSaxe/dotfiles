#!/usr/bin/env -S uv run -q --script
# /// script
# requires-python = ">=3.11"
# ///
"""Place the pokemon mascot in the focused herdr pane, bottom-right.

    herdr-mascot set <name>     place (fetching the sprite if needed)
    herdr-mascot clear          remove the overlay

Exits quietly when no herdr server is running, so the theme command can call
it unconditionally. Size defaults to a small corner sprite; override with
MASCOT_COLS / MASCOT_ROWS.
"""

from __future__ import annotations

import base64
import json
import os
import socket
import subprocess
import sys
from pathlib import Path

SOCKET_PATH = Path.home() / ".config/herdr/herdr.sock"
GRID_COLS = int(os.environ.get("MASCOT_COLS", "10"))
GRID_ROWS = int(os.environ.get("MASCOT_ROWS", "5"))


def request(method: str, params: dict) -> dict:
    with socket.socket(socket.AF_UNIX) as sock:
        sock.connect(str(SOCKET_PATH))
        sock.sendall(
            (
                json.dumps({"id": "mascot", "method": method, "params": params}) + "\n"
            ).encode()
        )
        sock.settimeout(5)
        chunks = b""
        while not chunks.endswith(b"\n"):
            data = sock.recv(65536)
            if not data:
                break
            chunks += data
    return json.loads(chunks)


def snapshot() -> dict:
    return request("session.snapshot", {})["result"]["snapshot"]


def all_pane_ids(snap: dict) -> list[str]:
    return [pane["pane_id"] for pane in snap.get("panes", [])]


def focused_pane(snap: dict) -> tuple[str, int, int] | None:
    pane_id = snap.get("focused_pane_id")
    for layout in snap.get("layouts", []):
        for pane in layout.get("panes", []):
            if pane["pane_id"] == pane_id:
                rect = pane["rect"]
                return pane_id, rect["width"], rect["height"]
    return None


def png_dimensions(data: bytes) -> tuple[int, int]:
    # Width and height live at fixed offsets in the IHDR chunk.
    return int.from_bytes(data[16:20]), int.from_bytes(data[20:24])


def sprite_path(name: str) -> Path:
    cache = (
        Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
        / "dotfiles/pokemon"
    )
    path = cache / f"{name}-sprite.png"
    if not path.exists():
        # pokemon-accents owns fetching; it caches the sprite as a side effect.
        subprocess.run(["pokemon-accents", name], check=True, capture_output=True)
    return path


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] not in ("set", "clear"):
        raise SystemExit("usage: herdr-mascot set <name> | clear")
    if not SOCKET_PATH.exists():
        return

    snap = snapshot()
    # Overlays are per-pane; clear everywhere first so exactly one mascot
    # exists (a leftover on an unfocused pane also drifts when splits resize).
    for pane_id in all_pane_ids(snap):
        request("pane.graphics.clear", {"pane_id": pane_id})
    if sys.argv[1] == "clear":
        return

    target = focused_pane(snap)
    if target is None:
        return
    pane_id, pane_cols, pane_rows = target

    data = sprite_path(sys.argv[2].lower()).read_bytes()
    width, height = png_dimensions(data)
    request(
        "pane.graphics.set",
        {
            "pane_id": pane_id,
            "format": "png",
            "image_width": width,
            "image_height": height,
            "data_base64": base64.b64encode(data).decode(),
            "placement": {
                "viewport_col": max(0, pane_cols - GRID_COLS - 1),
                "viewport_row": max(0, pane_rows - GRID_ROWS - 1),
                "grid_cols": GRID_COLS,
                "grid_rows": GRID_ROWS,
            },
        },
    )


if __name__ == "__main__":
    main()
