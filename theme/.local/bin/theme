#!/bin/sh
# One theme for every tool. Renders templates with the current palette and
# semantic tokens; consumers watch the rendered files and converge.
#
#   theme dark      switch to catppuccin mocha
#   theme light     switch to catppuccin latte
#   theme toggle    flip between them
#   theme apply     re-render the current mode (default: dark)
#   theme status    print the current mode
#
# Layers (see README: Theming):
#   palettes/*.conf   raw color values        (layer 1)
#   tokens.conf       role -> palette key     (layer 2)
#   templates/*.tmpl  {{role}} placeholders   (layer 3)
# Rendered output lands in state, never in the repo.
set -eu

# This script is invoked from contexts with a bare PATH (hammerspoon's
# appearance watcher, launchd) — make sure tmux and friends resolve.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Palettes, tokens, and templates live next to this script in its stow
# package; resolving our own symlink finds them wherever the repo lives.
SCRIPT_PATH="$(readlink -f "$0")"
PACKAGE_ROOT="${SCRIPT_PATH%/.local/bin/theme}"
CONFIG="${THEME_CONFIG:-$PACKAGE_ROOT/.config}/theme"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
# Pokemon mappings are machine-personal state (project names must never
# reach the public repo), not tracked config.
POKEMON_CONF="$STATE/pokemon.conf"
# The global default is shareable and tracked; see pokemon.conf in config.
DEFAULT_CONF="$CONFIG/pokemon.conf"
GENERATED="$STATE/generated"
MODE_FILE="$STATE/theme-mode"

current_mode() {
  if [ -f "$MODE_FILE" ]; then cat "$MODE_FILE"; else echo dark; fi
}

palette_for_mode() {
  case "$1" in
  dark) echo "$CONFIG/palettes/mocha.conf" ;;
  light) echo "$CONFIG/palettes/latte.conf" ;;
  esac
}

# Look up one key in a key=value conf file.
conf_get() {
  sed -n "s/^$2=//p" "$1"
}

# Set key=value in a conf file, replacing an existing entry (portable
# in-place: sed -i differs between BSD and GNU).
conf_put() {
  if grep -q "^$2=" "$1" 2>/dev/null; then
    sed "s|^$2=.*|$2=$3|" "$1" >"$1.tmp" && mv "$1.tmp" "$1"
  else
    printf '%s=%s\n' "$2" "$3" >>"$1"
  fi
}

# Remove a key from a conf file.
conf_del() {
  if grep -q "^$2=" "$1" 2>/dev/null; then
    grep -v "^$2=" "$1" >"$1.tmp" && mv "$1.tmp" "$1"
  fi
}

# Extract accents into state. $1 is the name, $2 non-empty means shiny.
# Display is not this command's job: the hammerspoon mascot watches state.
set_pokemon() {
  # Atomic write: a failed extraction must not clobber working accents.
  if ! pokemon-accents "$1" ${2:+--shiny} >"$STATE/.accents.tmp"; then
    rm -f "$STATE/.accents.tmp"
    exit 1
  fi
  mv "$STATE/.accents.tmp" "$STATE/accents.conf"
}

# Mapped values encode shininess as "<name>:shiny"; apply one.
set_pokemon_value() {
  case "$1" in
  *:shiny) set_pokemon "${1%:shiny}" 1 ;;
  *) set_pokemon "$1" "" ;;
  esac
}

render() {
  mode="$1"
  palette="$(palette_for_mode "$mode")"
  mkdir -p "$GENERATED"

  # Build a sed script resolving each {{role}} to its hex via the palette.
  # A pokemon (theme pokemon <name>) overrides accent/notify only,
  # with the pair extracted for the current background mode.
  accents="$STATE/accents.conf"
  # Per-process temp name: the appearance watcher and a manual `theme` can
  # render concurrently, and a shared file would corrupt both.
  sed_script="$STATE/.render.$$.sed"
  : >"$sed_script"
  while IFS='=' read -r role key; do
    case "$role" in ''#*) continue ;; esac
    hex="$(conf_get "$palette" "$key")"
    if [ -f "$accents" ]; then
      case "$role" in
      accent | notify)
        override="$(conf_get "$accents" "${role}_${mode}")"
        [ -n "$override" ] && hex="$override"
        ;;
      esac
    fi
    if [ -z "$hex" ]; then
      echo "error: token '$role' maps to '$key', not in $(basename "$palette")" >&2
      exit 1
    fi
    printf 's/{{%s}}/%s/g\n' "$role" "$hex" >>"$sed_script"
    # {{role_hex}} is the same color without '#', for formats that take raw
    # hex digits (e.g. GLSL int literals: 0x{{accent_hex}}).
    printf 's/{{%s_hex}}/%s/g\n' "$role" "${hex#\#}" >>"$sed_script"
  done <"$CONFIG/tokens.conf"

  # Templates may also reference palette keys directly ({{mauve}}, {{sky}},
  # {{green}}...) for SEMANTIC hue choices — meaning lives in the template,
  # identity-sync lives in the accent/notify tokens. Names never collide.
  # The palette's mode key renders too ({{mode}} -> dark|light), for
  # consumers that take the scheme by name. The _hex variant is only
  # emitted for color values.
  while IFS='=' read -r key hex; do
    case "$key" in ''#*) continue ;; esac
    printf 's/{{%s}}/%s/g\n' "$key" "$hex" >>"$sed_script"
    case "$hex" in
    \#*) printf 's/{{%s_hex}}/%s/g\n' "$key" "${hex#\#}" >>"$sed_script" ;;
    esac
  done <"$palette"

  for tmpl in "$CONFIG/templates/"*.tmpl; do
    # An unmatched glob stays literal; never render a file named "*".
    [ -e "$tmpl" ] || continue
    out="$GENERATED/$(basename "$tmpl" .tmpl)"
    sed -f "$sed_script" "$tmpl" >"$out"
    # A surviving {{...}} means a template used an unknown role. Fail loudly.
    if grep -q '{{' "$out"; then
      echo "error: unresolved tokens in $(basename "$tmpl"):" >&2
      grep -o '{{[a-z_]*}}' "$out" | sort -u >&2
      exit 1
    fi
  done
  rm -f "$sed_script"

  echo "$mode" >"$MODE_FILE"
  echo "theme: $mode"
}

# This script only WRITES state; it never pokes processes. It runs from
# many contexts (shells, ssh, hammerspoon, the tmux server) whose
# environments differ, and a push that works in one silently fails in
# another. Consumers converge on the generated files themselves:
#   starship   re-reads its config every prompt
#   zsh / fzf  precmd re-sources shell colors on mtime change (.zshrc)
#   tmux       status-interval sync re-sources tmux-colors.conf on mtime
#              change (tmux scripts/theme-sync.sh) — any OS, any context
#   mascot     hammerspoon watches the state directory
#   ghostty    palette follows macOS appearance natively; hammerspoon's
#              watcher sends the reload signal for the trail shader
publish_files() {
  # File copies are context-independent writes, so they belong here:
  # ghostty resolves custom-shader paths relative to its config dir.
  mkdir -p "$HOME/.config/ghostty/shaders"
  for shader in cursor_trail.glsl frame.glsl; do
    if [ -f "$GENERATED/$shader" ]; then
      cp "$GENERATED/$shader" "$HOME/.config/ghostty/shaders/$shader"
    fi
  done
}

# macOS appearance is the master light/dark switch: setting it flips ghostty
# (native light:/dark: theme pair) and anything else that follows the OS.
# The hammerspoon appearance watcher then re-runs this script for the same
# mode — idempotent, and setting an unchanged value fires no notification,
# so there is no loop. Silently a no-op off macOS or without permissions.
set_os_appearance() {
  case "$1" in
  dark) darkmode=true ;;
  light) darkmode=false ;;
  esac
  command -v osascript >/dev/null 2>&1 &&
    osascript -e "tell app \"System Events\" to tell appearance preferences to set dark mode to $darkmode" >/dev/null 2>&1 ||
    true
}

# Print a color as a filled block so switches are visible at a glance.
swatch() {
  r="$(printf '%d' "0x$(printf '%s' "$1" | cut -c2-3)")"
  g="$(printf '%d' "0x$(printf '%s' "$1" | cut -c4-5)")"
  b="$(printf '%d' "0x$(printf '%s' "$1" | cut -c6-7)")"
  printf '%-16s %s \033[48;2;%d;%d;%dm      \033[0m\n' "$2" "$1" "$r" "$g" "$b"
}

show_accents() {
  accents="$STATE/accents.conf"
  [ -f "$accents" ] || return 0
  mode="$(current_mode)"
  sparkle=""
  [ "$(conf_get "$accents" shiny)" = "1" ] && sparkle=" ✨shiny"
  echo "pokemon: $(conf_get "$accents" pokemon)$sparkle ($mode)"
  swatch "$(conf_get "$accents" "accent_$mode")" accent
  swatch "$(conf_get "$accents" "notify_$mode")" notify
}

case "${1:-status}" in
dark | light)
  set_os_appearance "$1"
  render "$1"
  publish_files
  ;;
toggle)
  case "$(current_mode)" in
  dark) set_os_appearance light && render light ;;
  *) set_os_appearance dark && render dark ;;
  esac
  publish_files
  ;;
apply)
  # `theme apply [dark|light]` renders WITHOUT touching OS appearance —
  # the entry point for followers (hammerspoon's appearance watcher), which
  # must never set the thing they react to, or toggles race themselves.
  mode="${2:-$(current_mode)}"
  case "$mode" in
  dark | light) ;;
  *)
    echo "usage: theme apply [dark|light]" >&2
    exit 1
    ;;
  esac
  render "$mode"
  publish_files
  ;;
pokemon)
  sub="${2:?usage: theme pokemon <name>|none|default <name>|project <name>|sync [project] [--shiny]}"
  case "$sub" in
  none)
    rm -f "$STATE/accents.conf"
    ;;
  sync)
    # Make the global accent follow a project: apply its mapped pokemon
    # (or the default), skipping the extraction when it is already active.
    # Session switchers (to/ts, rail jump) call this in the background.
    project="${3:-}"
    [ -n "$project" ] || project="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")"
    value=""
    [ -f "$POKEMON_CONF" ] && value="$(conf_get "$POKEMON_CONF" "$project")"
    [ -n "$value" ] || value="$(conf_get "$DEFAULT_CONF" default)"
    [ -n "$value" ] || exit 0
    current=""
    if [ -f "$STATE/accents.conf" ]; then
      current="$(conf_get "$STATE/accents.conf" pokemon)"
      [ "$(conf_get "$STATE/accents.conf" shiny)" = "1" ] && current="$current:shiny"
    fi
    [ "$value" = "$current" ] && exit 0
    set_pokemon_value "$value"
    ;;
  default)
    name="${3:?usage: theme pokemon default <name> [--shiny]}"
    value="$name"
    [ "${4:-}" = "--shiny" ] && value="$name:shiny"
    conf_put "$DEFAULT_CONF" default "$value"
    set_pokemon_value "$value"
    ;;
  project)
    project="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")"
    name="${3:?usage: theme pokemon project <name>|none [--shiny]}"
    if [ "$name" = none ]; then
      # Unmap this project and fall back to the global default, if one is set.
      conf_del "$POKEMON_CONF" "$project"
      echo "unmapped: $project"
      fallback="$(conf_get "$DEFAULT_CONF" default)"
      [ -n "$fallback" ] && set_pokemon_value "$fallback"
    else
      value="$name"
      [ "${4:-}" = "--shiny" ] && value="$name:shiny"
      conf_put "$POKEMON_CONF" "$project" "$value"
      echo "mapped: $project -> $value"
      set_pokemon_value "$value"
    fi
    ;;
  *)
    shinyflag=""
    [ "${3:-}" = "--shiny" ] && shinyflag=1
    set_pokemon "$sub" "$shinyflag"
    ;;
  esac
  render "$(current_mode)"
  publish_files
  show_accents
  ;;
status)
  current_mode
  show_accents
  ;;
*)
  echo "usage: theme dark|light|toggle|apply|status|pokemon <name>|none" >&2
  exit 1
  ;;
esac
