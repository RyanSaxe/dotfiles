#!/bin/sh
# Interactive theme switching with fzf. Bound to alt+c as a herdr popup;
# equally usable from any plain shell, including over SSH.
#
#   stage 1: toggle / light / dark / pokemon / shiny pokemon / none
#   stage 2: (pokemon) fuzzy-pick from the full pokedex
#   stage 3: (pokemon) scope — just now, this project, or global default
set -eu

pick() {
  fzf --reverse --prompt="$1 > " --height=100%
}

action="$(printf 'pokemon\nshiny pokemon\ntoggle\nlight\ndark\nnone\n' | pick theme)" || exit 0

case "$action" in
toggle | light | dark)
  theme "$action"
  ;;
none)
  theme pokemon none
  ;;
"pokemon" | "shiny pokemon")
  # Live sprite preview. chafa auto-detection sees a pipe inside fzf's
  # preview and would degrade to symbols, so force the kitty protocol in
  # ghostty (fzf renders it natively); elsewhere let it degrade for SSH.
  # Sprites come from the local cache only; prefetch fills it.
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/pokemon"
  suffix="-sprite.png"
  [ "$action" = "shiny pokemon" ] && suffix="-shiny-sprite.png"
  format=""
  if [ -n "${GHOSTTY_RESOURCES_DIR:-}" ] || [ "${TERM_PROGRAM:-}" = "ghostty" ]; then
    format="-f kitty"
  fi
  name="$(pokemon-accents --names | fzf --reverse --prompt="pokemon > " --height=100% \
    --preview "chafa $format --size 26x13 $cache/{}$suffix 2>/dev/null ||
      echo 'no sprite cached - run: pokemon-accents --prefetch-sprites'" \
    --preview-window=right,45%)" || exit 0
  scope="$(printf 'just now\nthis project\nglobal default\n' | pick scope)" || exit 0

  set -- pokemon
  case "$scope" in
  "this project") set -- pokemon project ;;
  "global default") set -- pokemon default ;;
  esac
  set -- "$@" "$name"
  [ "$action" = "shiny pokemon" ] && set -- "$@" --shiny

  theme "$@"
  ;;
esac

# Popups close on exit; give the eye a beat to confirm what happened.
sleep 1
