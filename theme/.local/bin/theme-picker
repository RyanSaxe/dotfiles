#!/bin/sh
# Interactive theme switching with fzf. Designed for a tmux popup keybind,
# and equally usable from any plain shell, including over SSH.
#
#   stage 1: toggle / light / dark / pokemon / shiny pokemon / none
#   stage 2: (pokemon) fuzzy-pick from the full pokedex
#   stage 3: (pokemon) scope — just now, this project, or global default
set -eu

pick() {
  fzf --reverse --prompt="$1 > " --height=100%
}

action="$(printf 'pokemon\nshiny pokemon\ntoggle\nlight\ndark\nnone\n' | pick theme)" || exit 0

case "$action" in
toggle | light | dark)
  # Mode changes are applied AFTER this script (and its popup) exits.
  # Flipping macOS appearance makes the terminal emit theme-change reports,
  # and tmux mangles those inside an open popup — they land in whatever is
  # focused as literal "?997;2n" keystrokes. With the popup already closed,
  # the reports arrive at panes that ignore them.
  nohup sh -c "sleep 0.3; theme '$action'" >/dev/null 2>&1 &
  exit 0
  ;;
none)
  theme pokemon none
  ;;
"pokemon" | "shiny pokemon")
  # Deliberately NO sprite preview: images through the fzf/tmux/terminal
  # pipeline proved fragile and slow, three regressions deep. The mascot
  # is the preview — it appears the moment you pick.
  name="$(pokemon-accents --names | pick pokemon)" || exit 0
  scope="$(printf 'just now\nthis project\nglobal default\n' | pick scope)" || exit 0

  set -- pokemon
  case "$scope" in
  "this project") set -- pokemon project ;;
  "global default") set -- pokemon default ;;
  esac
  set -- "$@" "$name"
  [ "$action" = "shiny pokemon" ] && set -- "$@" --shiny

  theme "$@"
  ;;
esac

# Popups close on exit; give the eye a beat to confirm what happened.
sleep 1
