#!/bin/sh
# The ONE place that decides how to draw a sprite in the current terminal
# context. Every consumer (picker preview, anything future) calls this;
# scattered per-context conditionals are how sprite rendering broke three
# separate times.
#
# Contexts:
#   SSH            -> character blocks (remote terminals lack kitty graphics)
#   ghostty + tmux -> kitty protocol wrapped in tmux passthrough
#                     (requires `allow-passthrough on`; set by our tmux.conf)
#   ghostty        -> kitty protocol directly
#   anything else  -> chafa's own auto-detection
set -eu

path="${1:?usage: pokemon-sprite-preview <sprite.png>}"
if [ ! -f "$path" ]; then
  echo "no sprite cached - run: pokemon-accents --prefetch-sprites"
  exit 0
fi

size="${MASCOT_PREVIEW_SIZE:-26x13}"

if [ -n "${SSH_CONNECTION:-}" ]; then
  exec chafa --animate off --size "$size" "$path"
fi

in_ghostty=false
if [ -n "${GHOSTTY_RESOURCES_DIR:-}" ] || [ "${LC_TERMINAL:-}" = "ghostty" ] ||
  [ "${TERM_PROGRAM:-}" = "ghostty" ]; then
  in_ghostty=true
fi

if [ "$in_ghostty" = true ] && [ -n "${TMUX:-}" ]; then
  # Delete stale placements, wrapped so tmux forwards it to ghostty.
  # Backslash is octal \134 so shellcheck knows nothing escapes a quote.
  printf '\033Ptmux;\033\033_Ga=d,d=A\033\033\134\033\134'
  exec chafa -f kitty --passthrough tmux --animate off --size "$size" "$path"
fi
if [ "$in_ghostty" = true ]; then
  printf '\033_Ga=d,d=A\033\134'
  exec chafa -f kitty --animate off --size "$size" "$path"
fi
exec chafa --animate off --size "$size" "$path"
