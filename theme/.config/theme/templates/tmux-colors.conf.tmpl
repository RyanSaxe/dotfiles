# Rendered by `theme` — do not edit; change the template or tokens instead.
# Sourced by tmux.conf at load, and re-sourced by `theme` on every render:
# all tmux styles reference these @variables, so a theme or pokemon switch
# recolors the running server with no restart.
set -g @bg "{{bg}}"
set -g @bg_alt "{{bg_alt}}"
set -g @fg "{{fg}}"
set -g @surface "{{bg_highlight}}"
set -g @border "{{border}}"
set -g @dim "{{fg_faint}}"
set -g @accent "{{accent}}"
set -g @notify "{{notify}}"
set -g @warn "{{warn}}"
set -g @info "{{info}}"

# Agent status glyph colors (see workmux config.yaml status_icons). These
# are semantic — deliberately palette keys, never the pokemon accents.
set -g @status_working "{{mauve}}"
set -g @status_waiting "{{peach}}"
set -g @status_done "{{green}}"
set -g @status_interrupted "{{red}}"
