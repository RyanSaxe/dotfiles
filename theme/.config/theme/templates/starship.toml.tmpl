# Rendered by `theme` — do not edit; change the template or tokens instead.
#
# Shape:
#   in nvim/lua/plugins on main from 3 hours ago ✓     <- subdir only when deep
#   dotfiles ❯                                          <- name color = venv state
#
# Line 1 says WHERE INSIDE (repo-relative subdir, or the plain path outside
# repos; nothing at the repo root). Line 2 says WHAT: the project name whose
# color is the venv state — faint none, green matching, red shows the name
# of a MISMATCHED venv. The caret never moves. Username appears only when
# it is information (root/SSH). Connectors are faint; values bold semantic.
add_newline = true
format = "$username${custom.subdir}${custom.dir_plain}$git_branch${custom.git_age}${custom.git_clean}${custom.git_dirty}$git_status$line_break${custom.proj_bad}${custom.proj_ok}${custom.proj_plain}${custom.pyversion}$character"

# Only shown when root or over SSH — locally it never changes, so it says
# nothing; remotely or elevated it is exactly the thing to notice.
[username]
format = '[$user]({{fg_faint}}) '

# WHERE, inside a repo: path relative to the repo root; hidden at the root
# itself. Long paths collapse to first/…/last/two.
[custom.subdir]
command = '''p="$(git rev-parse --show-prefix)"; p="${p%/}"; n=$(printf %s "$p" | awk -F/ "{print NF}"); if [ "$n" -gt 3 ]; then printf %s "${p%%/*}/…/$(printf %s "$p" | awk -F/ "{print \$(NF-1)\"/\"\$NF}")"; else printf %s "$p"; fi'''
when = '[ -n "$(git rev-parse --show-prefix 2>/dev/null)" ]'
format = '[in ]({{fg_faint}})[$output](bold {{sky}}) '

# WHERE, outside any repo: ~-relative path with the same collapsing.
[custom.dir_plain]
command = '''case "$PWD" in "$HOME") p="~" ;; "$HOME"/*) p="~${PWD#"$HOME"}" ;; *) p="$PWD" ;; esac; n=$(printf %s "$p" | awk -F/ "{print NF}"); if [ "$n" -gt 4 ]; then printf %s "${p%%/*}/…/$(printf %s "$p" | awk -F/ "{print \$(NF-1)\"/\"\$NF}")"; else printf %s "$p"; fi'''
when = '! git rev-parse --is-inside-work-tree >/dev/null 2>&1'
format = '[in ]({{fg_faint}})[$output](bold {{sky}}) '

[git_branch]
format = '[on ]({{fg_faint}})[$branch](bold {{mauve}}) '

# Time since last commit — connectors fold in so they vanish outside repos.
[custom.git_age]
command = "git log -1 --format=%cr 2>/dev/null | sed 's/ ago//'"
when = "git rev-parse --is-inside-work-tree >/dev/null 2>&1"
format = '[from ]({{fg_faint}})[$output](bold {{info}})[ ago]({{fg_faint}}) '

# Clean/dirty as a single glanceable mark.
[custom.git_clean]
command = "echo ✓"
when = 'git rev-parse --is-inside-work-tree >/dev/null 2>&1 && [ -z "$(git status --porcelain 2>/dev/null)" ]'
format = '[$output](bold {{green}}) '

[custom.git_dirty]
command = "echo ✗"
when = 'git rev-parse --is-inside-work-tree >/dev/null 2>&1 && [ -n "$(git status --porcelain 2>/dev/null)" ]'
format = '[$output](bold {{red}}) '

# Only ahead/behind arrows; state marks come from the customs above.
[git_status]
format = '([$ahead_behind]({{fg_faint}}) )'

# ---- line 2: project name as the venv status light --------------------
# No venv: faint. Venv belonging to this project: green. Venv from some
# OTHER project: red, showing the impostor's name.
[custom.proj_plain]
command = 'basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"'
when = '[ -z "$VIRTUAL_ENV" ]'
format = '[$output](bold {{lavender}}) '

[custom.proj_ok]
command = 'basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"'
when = '[ -n "$VIRTUAL_ENV" ] && [ "$(dirname "$VIRTUAL_ENV")" = "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" ]'
format = '[$output](bold {{green}}) '

[custom.proj_bad]
command = 'basename "$(dirname "$VIRTUAL_ENV")"'
when = '[ -n "$VIRTUAL_ENV" ] && [ "$(dirname "$VIRTUAL_ENV")" != "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" ]'
format = '[$output](bold {{red}}) '

# The venv's interpreter version, read from pyvenv.cfg — no subprocess,
# and wrong-python is the sneakier cousin of wrong-venv.
[custom.pyversion]
command = 'sed -n "s/^version *= *//p" "$VIRTUAL_ENV/pyvenv.cfg" | cut -d. -f1,2'
when = '[ -n "$VIRTUAL_ENV" ] && [ -f "$VIRTUAL_ENV/pyvenv.cfg" ]'
format = '[$output]({{fg_faint}}) '

[python]
disabled = true

[character]
success_symbol = "[❯]({{accent}})"
error_symbol = "[❯]({{red}})"
vimcmd_symbol = "[❮]({{mauve}})"
