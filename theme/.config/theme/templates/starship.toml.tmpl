# Rendered by `theme` — do not edit; change the template or tokens instead.
#
# Colors follow Ryan's semantic system: cyan = project identity, purple =
# operational (branch, vi normal mode), green/red = glance/look-now, faint =
# ambient info. The prompt character is the pokemon accent — sync, not
# semantics.
add_newline = true
format = "${custom.venv}$directory$git_branch${custom.git_clean}${custom.git_dirty}$git_status$line_break$character"
right_format = "$cmd_duration${custom.git_age}"

# Leading (venv-name): catches being in the wrong venv at a glance.
[custom.venv]
command = 'basename "$VIRTUAL_ENV"'
when = '[ -n "$VIRTUAL_ENV" ]'
format = '[\($output\) ]({{fg_faint}})'

[directory]
style = "bold {{sky}}"
truncation_length = 3

[git_branch]
format = '[$branch]({{mauve}}) '

# Clean/dirty as a single glanceable mark, per the claude-statusline habit.
[custom.git_clean]
command = "echo ✓"
when = 'git rev-parse --is-inside-work-tree >/dev/null 2>&1 && [ -z "$(git status --porcelain 2>/dev/null)" ]'
format = '[$output]({{green}}) '

[custom.git_dirty]
command = "echo ✗"
when = 'git rev-parse --is-inside-work-tree >/dev/null 2>&1 && [ -n "$(git status --porcelain 2>/dev/null)" ]'
format = '[$output]({{red}}) '

# Only ahead/behind arrows; state marks come from the customs above.
[git_status]
format = '([$ahead_behind]({{fg_faint}}) )'

# Right side: quiet ambient info. Bare duration, no "took".
[cmd_duration]
min_time = 2000
format = '[$duration · ]({{fg_faint}})'

# Time since last commit — ported from the v1 prompt.
[custom.git_age]
command = "git log -1 --format=%cr 2>/dev/null | sed 's/ ago//'"
when = "git rev-parse --is-inside-work-tree >/dev/null 2>&1"
format = '[$output]({{fg_faint}})'

[python]
disabled = true

[character]
success_symbol = "[❯]({{accent}})"
error_symbol = "[❯]({{red}})"
vimcmd_symbol = "[❮]({{mauve}})"
