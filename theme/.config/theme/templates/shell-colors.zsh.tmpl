# Rendered by `theme` — do not edit; change the template or tokens instead.
# Sourced by .zshrc when present.

# Ghost text (zsh-autosuggestions). v1 hardcoded this hex; now it is a token.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg={{ghost}}'

# fzf color flags, used two ways: joined into FZF_DEFAULT_OPTS for plain fzf,
# and appended to the fzf-tab popup via its fzf-flags zstyle (see .zshrc).
# fzf-tab deliberately ignores FZF_DEFAULT_OPTS, and inheriting it wholesale
# (use-fzf-default-opts) disturbs the popup's own flag set — flags only.
typeset -ga FZF_THEME_COLORS=(
  "--color=bg+:{{bg_highlight}},bg:{{bg}},border:{{border}}"
  "--color=fg:{{fg}},fg+:{{fg}},hl:{{accent}},hl+:{{accent_bright}}"
  "--color=info:{{info}},prompt:{{accent}},pointer:{{accent_bright}}"
  "--color=marker:{{success}},spinner:{{accent_bright}},header:{{fg_muted}}"
)
export FZF_DEFAULT_OPTS="${FZF_THEME_COLORS[*]}"
