-- Rendered by `theme` — do not edit; change the template or tokens instead.
-- Palette for hammerspoon consumers (the rail); dofile'd from generated
-- state and re-read on modification, so mode and pokemon switches apply
-- within a tick.
return {
  mode = "{{mode}}",
  accent = "{{accent}}",
  base = "{{base}}",
  mantle = "{{mantle}}",
  -- The rail's slab color: hs.canvas renders hex lighter than terminals do
  -- (colorspace handling), so this is crust — compensated to read as mantle.
  rail_bg = "{{crust}}",
  surface0 = "{{surface0}}",
  surface1 = "{{surface1}}",
  text = "{{text}}",
  dim = "{{overlay0}}",
  dim2 = "{{overlay2}}",
  lavender = "{{lavender}}",
  mauve = "{{mauve}}",
  peach = "{{peach}}",
  green = "{{green}}",
  red = "{{red}}",
}
