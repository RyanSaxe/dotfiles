#!/usr/bin/env zsh
# Rendered by `theme` — do not edit; change this template or tokens instead.
# Sourced by sketchybarrc and every plugin (see sketchybar/dot-config/sketchybar/
# colors.sh). ARGB strings for sketchybar's own color format, built from the
# bare-hex-digit variant `theme` emits alongside every color token.

# Crust, not base: the bar shares the terminal frame's darkest tier so the
# menu bar and the window chrome read as one continuous surface.
export BAR_COLOR="0xff{{crust_hex}}"
export ITEM_BG="0x00000000"
# The measured macOS window-stroke color (see palettes), so the bar's
# border matches the hairline the OS draws around every window.
export BORDER_COLOR="0xff{{os_window_stroke_hex}}"

# fg_faint (the dim tier the rail and tmux share), not fg_muted: bar text
# should be present but quiet.
export ICON_COLOR="0xff{{fg_faint_hex}}"
export LABEL_COLOR="0xff{{fg_faint_hex}}"

# Mascot-linked: theme mascot <provider:id> overrides these two only.
export ACCENT_COLOR="0xff{{accent_hex}}"
export NOTIFY_COLOR="0xff{{notify_hex}}"

export WORKSPACE_ACTIVE_FG="0xff{{accent_hex}}"
export WORKSPACE_ACTIVE_BG="0x33{{accent_hex}}"
export WORKSPACE_INACTIVE_FG="0xff{{fg_faint_hex}}"
export WORKSPACE_INACTIVE_BG="0x00000000"

# The clock's meeting-warning state (see plugins/clock.sh).
export TIME_NORMAL="0xff{{accent_hex}}"
export TIME_HIGHLIGHT="0xff{{notify_hex}}"

# Agent attention (the code-workspace highlight, fed by the rail daemon):
# the rail's status semantics — waiting outranks done, and both are
# semantic tokens, never mascot accents.
export AGENT_WAITING_FG="0xff{{status_waiting_hex}}"
export AGENT_WAITING_BG="0x33{{status_waiting_hex}}"
export AGENT_DONE_FG="0xff{{status_done_hex}}"
export AGENT_DONE_BG="0x33{{status_done_hex}}"

# Threshold colors for battery/cpu/memory. warn is a semantic token; danger
# has no role of its own, so it names the red palette hue directly (see
# starship.toml.tmpl's use of raw palette keys for the same pattern).
export WARN_COLOR="0xff{{warn_hex}}"
export DANGER_COLOR="0xff{{red_hex}}"
