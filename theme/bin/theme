#!/bin/sh
# One theme for every tool. Renders templates with the current palette and
# semantic tokens; consumers watch the rendered files and converge.
#
#   theme dark|light           switch mode (sets macOS appearance too)
#   theme toggle               flip to the other mode
#   theme apply                re-render the persisted mode
#   theme apply dark|light     render + persist without touching macOS
#                              appearance (for appearance watchers)
#   theme status               print the mode and accents
#
# Layers (see README: Theming):
#   palettes/*.conf   raw color values                    (layer 1)
#   tokens.conf       role -> palette key                 (layer 2)
#   elements.conf     mode-pinned render exceptions       (layer 3)
#   templates/*.tmpl  {{role}} placeholders               (layer 4)
# Templates render in the current mode unless elements.conf pins them to
# dark or light (ghostty reads both of its theme files at once).
# Rendered output lands in state, never in the repo.
set -eu

# This script is invoked from contexts with a bare PATH (launchd) —
# make sure tmux and friends resolve.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Palettes, tokens, and templates live in the component directory above
# this script; resolving our own symlink finds them wherever the repo lives.
SCRIPT_PATH="$(readlink -f "$0")"
PACKAGE_ROOT="${SCRIPT_PATH%/bin/theme}"
CONFIG="${THEME_CONFIG:-$PACKAGE_ROOT}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
# Mascot mappings are machine-personal state (project names must never
# reach the public repo), not tracked config.
MASCOT_CONF="$STATE/mascot.conf"
# The global default is shareable and tracked; see mascot.conf in config.
DEFAULT_CONF="$CONFIG/mascot.conf"
GENERATED="$STATE/generated"
MODE_FILE="$STATE/mode"
ELEMENTS="$CONFIG/elements.conf"

current_mode() {
  [ -f "$MODE_FILE" ] || {
    echo dark
    return
  }
  stored_mode="$(cat "$MODE_FILE")"
  case "$stored_mode" in
  dark | light) echo "$stored_mode" ;;
  *)
    # A corrupt file must not kill every render (watchers call `theme
    # apply`); fall back like a missing file, and say which file to fix.
    echo "warning: $MODE_FILE holds '$stored_mode', not dark|light; using dark" >&2
    echo dark
    ;;
  esac
}

set_mode() {
  mkdir -p "$STATE"
  printf '%s\n' "$1" >"$MODE_FILE.tmp.$$"
  mv "$MODE_FILE.tmp.$$" "$MODE_FILE"
}

palette_for_mode() {
  case "$1" in
  dark) echo "$CONFIG/palettes/mocha.conf" ;;
  light) echo "$CONFIG/palettes/latte.conf" ;;
  esac
}

# Look up one key in a key=value conf file. Keys pass through ENVIRON so
# regex/replacement metacharacters stay literal — project keys are arbitrary
# directory names.
conf_get() {
  key="$2" awk -F= '$1 == ENVIRON["key"] {
    print substr($0, length(ENVIRON["key"]) + 2)
  }' "$1"
}

# Set key=value in a conf file, replacing an existing entry (portable
# in-place: sed -i differs between BSD and GNU).
conf_put() {
  [ -f "$1" ] || : >"$1"
  key="$2" value="$3" awk -F= '
    $1 == ENVIRON["key"] { print ENVIRON["key"] "=" ENVIRON["value"]; found = 1; next }
    { print }
    END { if (!found) print ENVIRON["key"] "=" ENVIRON["value"] }
  ' "$1" >"$1.tmp" && mv "$1.tmp" "$1"
}

# Remove a key from a conf file; the file is untouched when the key is
# absent (state files have mtime watchers).
conf_del() {
  [ -f "$1" ] || return 0
  key="$2" awk -F= '$1 != ENVIRON["key"]' "$1" >"$1.tmp"
  if cmp -s "$1.tmp" "$1"; then
    rm -f "$1.tmp"
  else
    mv "$1.tmp" "$1"
  fi
}

# Project keys are tmux session names: every mapping consumer (session
# switchers, rail jumps) passes the session it targets, so interactive
# resolution must match — including inside popups, whose cwd is the
# session's creation directory, not the viewed pane. The repo/directory
# name stands in only outside tmux.
current_project() {
  if [ -n "${TMUX:-}" ]; then
    tmux display-message -p '#{session_name}'
    return
  fi
  basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
}

# Extract accents into state. $1 is a provider-qualified identity
# (e.g. pokemon:raikou). Display is not this command's job: the rail
# mascot watches state.
set_mascot() {
  # Atomic write: a failed extraction must not clobber working accents.
  if ! mascot-accents "$1" >"$STATE/.accents.tmp"; then
    rm -f "$STATE/.accents.tmp"
    exit 1
  fi
  mv "$STATE/.accents.tmp" "$STATE/accents.conf"
}

# Older installations stored per-layer modes (inner-mode/outer-mode) or a
# single theme-mode. Seed the mode file from inner-mode — the layer that
# drove macOS appearance, so the truthful one — then delete the legacy
# files; the mode file is the only mode state afterwards.
migrate_mode_state() {
  if [ ! -f "$MODE_FILE" ]; then
    for legacy in "$STATE/inner-mode" "$STATE/theme-mode"; do
      [ -f "$legacy" ] || continue
      legacy_mode="$(cat "$legacy")"
      case "$legacy_mode" in
      dark | light)
        set_mode "$legacy_mode"
        break
        ;;
      esac
    done
  fi
  rm -f "$STATE/inner-mode" "$STATE/outer-mode" "$STATE/theme-mode"
}

# One-time migration from the pre-provider layout: mapped values gain
# their provider prefix (X -> pokemon:X, X:shiny -> shiny-pokemon:X) and
# accents.conf regenerates in the provider-qualified format (identity +
# sprite pointer). Every image involved is already cached, so this is
# offline; on failure the legacy file stays and the next run retries.
migrate_legacy_state() {
  if [ -f "$STATE/pokemon.conf" ] && [ ! -f "$MASCOT_CONF" ]; then
    sed -e 's/=\(.*\):shiny$/=shiny-pokemon:\1/' -e 't' -e 's/=/=pokemon:/' \
      "$STATE/pokemon.conf" >"$MASCOT_CONF"
    rm "$STATE/pokemon.conf"
  fi
  legacy=""
  [ -f "$STATE/accents.conf" ] && legacy="$(conf_get "$STATE/accents.conf" pokemon)"
  if [ -n "$legacy" ]; then
    value="pokemon:$legacy"
    [ "$(conf_get "$STATE/accents.conf" shiny)" = "1" ] && value="shiny-pokemon:$legacy"
    if mascot-accents "$value" >"$STATE/.accents.tmp" 2>/dev/null; then
      mv "$STATE/.accents.tmp" "$STATE/accents.conf"
    else
      rm -f "$STATE/.accents.tmp"
    fi
  fi
}

# Emit sed substitutions for one mapping pass — every token role, then every
# raw palette key, under the given placeholder prefix. One awk join over
# tokens.conf + palette (+ accent overrides); per-key lookups here once cost
# hundreds of process spawns per render.
emit_mapping() {
  acc_arg=""
  [ -f "$accents" ] && acc_arg="$accents"
  awk -F= -v mode="$1" -v prefix="$3" -v palette_name="$(basename "$2")" '
    function val(line, i) {
      i = index(line, "=")
      return i ? substr(line, i + 1) : ""
    }
    BEGIN {
      pal_file = ARGV[ARGC - 2]
      acc_file = (ARGC == 4) ? ARGV[1] : ""
    }
    $1 == "" || $1 ~ /^#/ { next }
    FILENAME == acc_file {
      acc[$1] = val($0)
      next
    }
    FILENAME == pal_file {
      pal[$1] = val($0)
      # Palette lines land after the token lines, as {{key}} plus {{key_hex}}
      # for color values; buffered because pal[] must fill before tokens read.
      palette_out = palette_out sprintf("s/{{%s%s}}/%s/g\n", prefix, $1, val($0))
      if (val($0) ~ /^#/)
        palette_out = palette_out \
          sprintf("s/{{%s%s_hex}}/%s/g\n", prefix, $1, substr(val($0), 2))
      next
    }
    {
      role = $1
      hex = pal[val($0)]
      if (acc_file != "" && (role == "accent" || role == "notify") &&
        acc[role "_" mode] != "")
        hex = acc[role "_" mode]
      if (hex == "") {
        printf "error: token '\''%s'\'' maps to '\''%s'\'', not in %s\n", \
          role, val($0), palette_name >"/dev/stderr"
        errored = 1
        exit 1
      }
      printf "s/{{%s%s}}/%s/g\n", prefix, role, hex
      sub(/^#/, "", hex)
      printf "s/{{%s%s_hex}}/%s/g\n", prefix, role, hex
    }
    END {
      if (errored) exit 1
      printf "%s", palette_out
      printf "s/{{%smode}}/%s/g\n", prefix, mode
    }
  ' ${acc_arg:+"$acc_arg"} "$2" "$CONFIG/tokens.conf"
}

render_template() {
  template="$1"
  output="$2"
  sed_script="$3"
  tmp="$workdir/$(basename "$output").tmp"

  sed -f "$sed_script" "$template" >"$tmp"
  if grep -q '{{' "$tmp"; then
    echo "error: unresolved tokens in $(basename "$template"):" >&2
    grep -o '{{[^}]*}}' "$tmp" | sort -u >&2
    exit 1
  fi
  if [ ! -f "$output" ] || ! cmp -s "$tmp" "$output"; then
    mv "$tmp" "$output"
  else
    rm -f "$tmp"
  fi
}

# Renders the persisted layer modes, or the explicitly passed pair
# (inner outer) when the caller has not committed them to state yet.
render() {
  mode="${1:-$(current_mode)}"
  mkdir -p "$GENERATED"

  accents="$STATE/accents.conf"

  # The workdir holds the prebuilt substitution scripts and render temp
  # files; the trap cleans it on every exit path.
  workdir="$STATE/.render.$$"
  trap 'rm -rf "$workdir"' EXIT
  mkdir -p "$workdir"
  emit_mapping "$mode" "$(palette_for_mode "$mode")" "" >"$workdir/mode.sed"
  # Mode-pinned contexts: templates that must exist for BOTH modes at
  # once — ghostty's native macOS-appearance switching reads a light and
  # a dark theme file simultaneously — regardless of the current mode.
  emit_mapping dark "$(palette_for_mode dark)" "" >"$workdir/dark.sed"
  emit_mapping light "$(palette_for_mode light)" "" >"$workdir/light.sed"

  for tmpl in "$CONFIG/templates/"*.tmpl; do
    # An unmatched glob stays literal; never render a file named "*".
    [ -e "$tmpl" ] || continue
    out="$GENERATED/$(basename "$tmpl" .tmpl)"
    element="$(conf_get "$ELEMENTS" "$(basename "$tmpl" .tmpl)")"
    case "$element" in
    dark | light) render_template "$tmpl" "$out" "$workdir/$element.sed" ;;
    '') render_template "$tmpl" "$out" "$workdir/mode.sed" ;;
    *)
      echo "error: elements.conf pins $(basename "$tmpl") to '$element', not dark|light" >&2
      exit 1
      ;;
    esac
  done

  publish_files
  echo "theme: mode=$mode"
}

# This script writes state and performs the small reloads required by
# consumers that cannot watch their generated files. It runs from
# many contexts (shells, ssh, the tmux server) whose environments differ,
# and a push that works in one silently fails in another. Consumers
# converge on the generated files themselves:
#   bat        receives the generated theme and rebuilds its cache when it changes
#   starship   re-reads its config every prompt
#   zsh / fzf / F-Sy-H  precmd reapplies generated colors on mtime change
#              (.zshrc)
#   tmux       rail daemon watches the generated dir and re-sources
#              tmux-colors.conf on change (tmux scripts/theme-sync.sh)
#   mascot     rail watches the state directory
#   ghostty    palette follows macOS appearance natively; custom shaders
#              pick up new content on the next config reload
# Every directory this function writes into must be listed in the tier
# map's create directive: it must exist as a real directory before links
# deploy, or a link there would send these writes inside the repo
# (see docs/install.md).
publish_files() {
  # File copies are context-independent writes: ghostty resolves
  # custom-shader paths relative to its config dir. Every rendered .glsl
  # is a shader by convention — no name list to maintain.
  mkdir -p "$HOME/.config/ghostty/shaders"
  for shader in "$GENERATED"/*.glsl; do
    [ -f "$shader" ] || continue
    cp "$shader" "$HOME/.config/ghostty/shaders/$(basename "$shader")"
  done
  # Ghostty's native light/dark flip reads both theme files by name.
  mkdir -p "$HOME/.config/ghostty/themes"
  for gtheme in "$GENERATED"/dotfiles-*; do
    [ -f "$gtheme" ] || continue
    cp "$gtheme" "$HOME/.config/ghostty/themes/$(basename "$gtheme")"
  done
  publish_bat_theme
  publish_codex_theme
  # Exceptions to "never poke processes", for consumers with no
  # file-watching path of their own. Both are idempotent no-ops when the
  # target isn't running:
  #   ghostty re-reads shader FILES only on a config reload (SIGUSR2) —
  #   its native light/dark flip doesn't trigger one.
  #   sketchybar converges instantly on this event; its 30s mtime timer
  #   (plugins/theme-sync.sh) is only the backstop.
  pkill -USR2 -x ghostty 2>/dev/null || true
  command -v sketchybar >/dev/null 2>&1 &&
    sketchybar --trigger theme_changed 2>/dev/null || true
}

# Codex reads TextMate themes from its native themes directory. Keep that
# runtime copy in sync with the same generated palette used by bat and nvim.
publish_codex_theme() {
  codex_theme="$GENERATED/Dotfiles.tmTheme"
  [ -f "$codex_theme" ] || return 0
  codex_dir="${CODEX_HOME:-$HOME/.codex}/themes"
  mkdir -p "$codex_dir"
  if [ ! -f "$codex_dir/dotfiles.tmTheme" ] ||
    ! cmp -s "$codex_theme" "$codex_dir/dotfiles.tmTheme"; then
    cp "$codex_theme" "$codex_dir/dotfiles.tmTheme"
  fi
}

# bat has no token/template layer of its own: publish the rendered inner
# theme into its normal config directory and rebuild only when its content
# actually changed. Renders run concurrently (session switchers background
# `theme mascot sync`), and parallel `bat cache --build` runs churn the
# cache directory — a mkdir lock serializes the publish (flock is not
# portable to macOS). The content check runs under the lock, so a waiter
# whose theme another render already published coalesces into a no-op.
# `batcat` is the Debian/Ubuntu binary name.
publish_bat_theme() {
  bat_theme="$GENERATED/Dotfiles.tmTheme"
  [ -f "$bat_theme" ] || return 0
  bat_dir="$HOME/.config/bat/themes"
  mkdir -p "$bat_dir"
  lock="$STATE/.bat-publish.lock"
  waited=0
  until mkdir "$lock" 2>/dev/null; do
    holder="$(cat "$lock/pid" 2>/dev/null || true)"
    # A holder that died mid-rebuild must not wedge every later render.
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
      rm -rf "$lock"
      continue
    fi
    if [ "$waited" -ge 30 ]; then
      echo "warning: bat publish lock is stuck, skipping cache rebuild" >&2
      return 0
    fi
    waited=$((waited + 1))
    sleep 1
  done
  echo $$ >"$lock/pid"
  status=0
  if [ ! -f "$bat_dir/Dotfiles.tmTheme" ] ||
    ! cmp -s "$bat_theme" "$bat_dir/Dotfiles.tmTheme"; then
    cp "$bat_theme" "$bat_dir/Dotfiles.tmTheme"
    rebuild_bat_cache || status=$?
  fi
  rm -rf "$lock"
  return $status
}

# Routine rebuild progress stays off the terminal; errors still reach stderr.
rebuild_bat_cache() {
  if command -v bat >/dev/null 2>&1; then
    bat cache --build >/dev/null
  elif command -v batcat >/dev/null 2>&1; then
    batcat cache --build >/dev/null
  fi
}

# macOS appearance is the master light/dark switch: setting it flips ghostty
# (native light:/dark: theme pair) and anything else that follows the OS.
# No watcher reacts to this — `theme dark/light/toggle` renders and sets
# the OS flag in the same call, so nothing needs to loop back. Silently a
# no-op off macOS or without permissions.
set_os_appearance() {
  case "$1" in
  dark) darkmode=true ;;
  light) darkmode=false ;;
  esac
  command -v osascript >/dev/null 2>&1 &&
    osascript -e "tell app \"System Events\" to tell appearance preferences to set dark mode to $darkmode" >/dev/null 2>&1 ||
    true
}

# Print a color as a filled block so switches are visible at a glance.
swatch() {
  r="$(printf '%d' "0x$(printf '%s' "$1" | cut -c2-3)")"
  g="$(printf '%d' "0x$(printf '%s' "$1" | cut -c4-5)")"
  b="$(printf '%d' "0x$(printf '%s' "$1" | cut -c6-7)")"
  printf '%-16s %s \033[48;2;%d;%d;%dm      \033[0m\n' "$2" "$1" "$r" "$g" "$b"
}

show_accents() {
  accents="$STATE/accents.conf"
  [ -f "$accents" ] || return 0
  mode="$(current_mode)"
  echo "mascot: $(conf_get "$accents" mascot) (mode=$mode)"
  swatch "$(conf_get "$accents" "accent_$mode")" accent
  swatch "$(conf_get "$accents" "notify_$mode")" notify
}

mkdir -p "$STATE"
migrate_mode_state
migrate_legacy_state

apply_mode() {
  case "$1" in
  dark | light) mode="$1" ;;
  toggle)
    [ "$(current_mode)" = dark ] && mode=light || mode=dark
    ;;
  *)
    echo "error: mode must be dark, light, or toggle" >&2
    exit 1
    ;;
  esac
  # Render before persisting: a failed render must not leave the mode file
  # or the OS appearance reporting a theme the generated files never got.
  render "$mode"
  set_mode "$mode"
  set_os_appearance "$mode"
}

case "${1:-status}" in
dark | light | toggle)
  apply_mode "$1"
  ;;
apply)
  # `theme apply` catches generated consumers up with the persisted mode
  # without touching OS appearance. The one-argument form is for
  # appearance watchers: render + persist, no osascript loop-back.
  case "${2:-}" in
  '') render ;;
  dark | light)
    render "$2"
    set_mode "$2"
    ;;
  *)
    echo "usage: theme apply [dark|light]" >&2
    exit 1
    ;;
  esac
  ;;
mascot)
  sub="${2:?usage: theme mascot <provider:id>|none|default <provider:id>|project <provider:id>|none|sync [project]}"
  case "$sub" in
  none)
    rm -f "$STATE/accents.conf"
    ;;
  sync)
    # Make the global accent follow a project: apply its mapped mascot
    # (or the default), skipping the extraction when it is already active.
    # Session switchers (to/ts, rail jump) call this in the background.
    project="${3:-}"
    [ -n "$project" ] || project="$(current_project)"
    value=""
    [ -f "$MASCOT_CONF" ] && value="$(conf_get "$MASCOT_CONF" "$project")"
    [ -n "$value" ] || value="$(conf_get "$DEFAULT_CONF" default)"
    [ -n "$value" ] || exit 0
    current=""
    [ -f "$STATE/accents.conf" ] && current="$(conf_get "$STATE/accents.conf" mascot)"
    [ "$value" = "$current" ] && exit 0
    set_mascot "$value"
    ;;
  default)
    value="${3:?usage: theme mascot default <provider:id>}"
    # Extraction validates the identity; only a working value may persist
    # (this file is repo-tracked).
    set_mascot "$value"
    conf_put "$DEFAULT_CONF" default "$value"
    ;;
  project)
    project="$(current_project)"
    value="${3:?usage: theme mascot project <provider:id>|none}"
    if [ "$value" = none ]; then
      # Unmap this project and fall back to the global default, if one is set.
      conf_del "$MASCOT_CONF" "$project"
      echo "unmapped: $project"
      fallback="$(conf_get "$DEFAULT_CONF" default)"
      [ -n "$fallback" ] && set_mascot "$fallback"
    else
      # Extraction validates the identity; a failed value must not persist —
      # background syncs would retry it forever.
      set_mascot "$value"
      conf_put "$MASCOT_CONF" "$project" "$value"
      echo "mapped: $project -> $value"
    fi
    ;;
  *)
    set_mascot "$sub"
    ;;
  esac
  render
  show_accents
  ;;
status)
  echo "mode: $(current_mode)"
  show_accents
  ;;
*)
  echo "usage: theme dark|light|toggle|apply [dark|light]|status|mascot <provider:id>|none" >&2
  exit 1
  ;;
esac
