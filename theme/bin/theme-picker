#!/bin/sh
# Interactive theme switching with fzf. Designed for a tmux popup keybind,
# and equally usable from any plain shell, including over SSH.
#
#   stage 1: mascot providers (from the registry) / toggle / light /
#            dark / none
#   stage 2: (provider) fuzzy-pick an identity
#   stage 3: (provider) scope — this project or global default
set -eu

pick() {
  fzf --reverse --prompt="$1 > " --height=100%
}

# Provider entries come from the registry; the picker hardcodes none.
providers="$(mascot-accents --providers 2>/dev/null || true)"

action="$(
  {
    [ -n "$providers" ] && printf '%s\n' "$providers"
    printf 'toggle\nlight\ndark\nclear projects\nnone\n'
  } | pick theme
)" || exit 0

case "$action" in
toggle | light | dark)
  # Mode changes are applied AFTER this script (and its popup) exits.
  # Flipping macOS appearance makes the terminal emit theme-change reports,
  # and tmux mangles those inside an open popup — they land in whatever is
  # focused as literal "?997;2n" keystrokes. With the popup already closed,
  # the reports arrive at panes that ignore them.
  # The job runs on the tmux server (run-shell -b): popup teardown kills the
  # popup's whole process group, so a backgrounded child would die with it.
  if [ -n "${TMUX:-}" ]; then
    # Silenced: tmux displays run-shell output in a dismiss-with-enter view.
    # theme-sync runs right after so tmux recolors instantly — this job is
    # already inside the tmux server, the same context the periodic pull
    # uses, so it shares none of the fragility of external pushes.
    tmux run-shell -b "sleep 0.3; \"$HOME/.local/bin/theme\" $action >/dev/null 2>&1; \"$HOME/.config/tmux/scripts/theme-sync.sh\" >/dev/null 2>&1 || true"
  else
    theme "$action"
  fi
  exit 0
  ;;
"clear projects")
  # Every project back onto the global default.
  theme mascot clear-projects
  ;;
none)
  theme mascot none
  ;;
*)
  # Deliberately NO sprite preview: images through the fzf/tmux/terminal
  # pipeline proved fragile and slow, three regressions deep. The mascot
  # is the preview — it appears the moment you pick.
  name="$(mascot-accents --identities "$action" | pick "$action")" || exit 0
  # "just now" was deprecated: the visible accent always follows the
  # current session's effective mascot (project mapping, else default),
  # so a scope-less immediate set had nothing coherent to mean.
  scope="$(printf 'this project\nglobal default\n' | pick scope)" || exit 0

  case "$scope" in
  "this project") theme mascot project "$action:$name" ;;
  "global default") theme mascot default "$action:$name" ;;
  esac
  ;;
esac

# Popups close on exit; give the eye a beat to confirm what happened.
sleep 1
