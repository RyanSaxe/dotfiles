#compdef theme
# Completion for the theme command; cached mascot identities complete
# provider-qualified (pokemon:raikou), from each provider's names cache.

if (( CURRENT == 2 )); then
  local -a subcommands=(
    'dark:switch to the dark palette'
    'light:switch to the light palette'
    'toggle:flip between dark and light'
    'apply:re-render the persisted mode'
    'status:print mode and mascot accents'
    'mascot:accent colors and sprite from a mascot'
  )
  _describe 'theme command' subcommands
elif [[ $words[2] == apply ]]; then
  if (( CURRENT == 3 )); then
    local -a modes=(
      'dark:render and persist dark without touching macOS appearance'
      'light:render and persist light without touching macOS appearance'
    )
    _describe 'theme mode' modes
  fi
elif [[ $words[2] == mascot ]]; then
  # Provider-qualified identities straight from the registry: cache
  # directory names don't map 1:1 to providers (shiny-pokemon shares the
  # pokemon names cache). compadd (not _describe): the values contain
  # colons. Errors silenced — no registry means no identity completions.
  local -a values=()
  values=(${(f)"$(mascot-accents --values 2>/dev/null)"})
  if (( CURRENT == 3 )); then
    _alternative \
      "actions:action:(none default project sync)" \
      "mascots:mascot:compadd -a values"
  elif [[ $words[3] == (default|project) ]]; then
    compadd -a values
  fi
fi
