#compdef theme
# Completion for the theme command; cached pokemon complete by name.

if (( CURRENT == 2 )); then
  local -a subcommands=(
    'dark:switch to catppuccin mocha'
    'light:switch to catppuccin latte'
    'toggle:flip between dark and light'
    'apply:re-render the current mode'
    'status:print mode and pokemon accents'
    'pokemon:accent colors from a pokemon'
  )
  _describe 'theme command' subcommands
elif [[ $words[2] == pokemon ]]; then
  # Full pokedex once pokemon-accents has cached it; cheap and offline.
  local names_file="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/pokemon/names.txt"
  local -a names=()
  [[ -r $names_file ]] && names=(${(f)"$(< "$names_file")"})
  if (( CURRENT == 3 )); then
    _alternative \
      "actions:action:(none default project)" \
      "pokemon:pokemon:($names)"
  elif [[ $words[3] == (default|project) ]]; then
    _describe 'pokemon' names
  elif (( CURRENT == 4 || CURRENT == 5 )); then
    _describe 'flag' '(--shiny)'
  fi
fi
