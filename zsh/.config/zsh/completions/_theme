#compdef theme
# Completion for the theme command; cached mascot identities complete
# provider-qualified (pokemon:raikou), from each provider's names cache.

if (( CURRENT == 2 )); then
  local -a subcommands=(
    'dark:switch to catppuccin mocha'
    'light:switch to catppuccin latte'
    'toggle:flip between dark and light'
    'apply:re-render the current mode'
    'status:print mode and mascot accents'
    'mascot:accent colors and sprite from a mascot'
  )
  _describe 'theme command' subcommands
elif [[ $words[2] == mascot ]]; then
  # Provider-qualified identities from the per-provider name caches;
  # cheap and offline. compadd (not _describe): the values contain colons.
  local -a values=() names=()
  local names_file
  for names_file in "${XDG_CACHE_HOME:-$HOME/.cache}"/dotfiles/mascots/*/names.txt(N); do
    names=(${(f)"$(< "$names_file")"})
    values+=("${names[@]/#/${names_file:h:t}:}")
  done
  if (( CURRENT == 3 )); then
    _alternative \
      "actions:action:(none default project sync)" \
      "mascots:mascot:compadd -a values"
  elif [[ $words[3] == (default|project) ]]; then
    compadd -a values
  fi
fi
