# Editors read this file. Its settings mirror the formatters' own config
# files, so a change to one needs the same change to the other.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python: ruff, in ruff.toml
[*.py]
indent_size = 4
max_line_length = 120

# Web, JSON, YAML and TOML: oxfmt
[*.{css,html,js,cjs,mjs,jsx,ts,cts,mts,tsx,json,yaml,yml,toml}]
max_line_length = 80

# Markdown: rumdl, in .rumdl.toml
[*.md]
max_line_length = 80

# Go: gofumpt and gofmt, in pkgs/ws/.golangci.yml
[*.go]
indent_style = tab
indent_size = 4
max_line_length = 100

# Lua: stylua, in stylua.toml
[*.lua]
indent_size = 2
max_line_length = 120

# Shell: shfmt -i 2
[*.{sh,bash,zsh}]
indent_size = 2

# Nix: nixfmt
[*.nix]
indent_size = 2

# Makefile syntax requires literal tabs.
[Makefile]
indent_style = tab
