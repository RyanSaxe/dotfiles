#!/bin/bash
# pair runs `spawn DIR COMMAND ARG…`, with no shell, to open an agent CLI in
# a new terminal in DIR. Inside tmux or Rex, `ws tab` opens it in a new tab
# of DIR's place, the tab or session ws opened DIR in, and opens that place
# first when DIR has none. Outside both, it opens a new Terminal window.
# tmux comes first, as in ws, because a tmux inside a Rex tab is what the
# caller sees. A tmux server that has stopped, or a Rex session that has
# closed, passes to the next choice.
set -e

if [ "$#" -lt 2 ]; then
  echo "usage: spawn DIR COMMAND [ARG…]" >&2
  exit 2
fi
dir=$1
shift

# A new terminal starts from the login environment, not the caller's. These
# variables go with the command, each one only when the caller sets it, even
# to an empty value, so that the new agent runs the same pair and CLI and
# reaches the caller's hub and state. Without them, an agent spawned from a
# scratch hub would register in the user's own state.
pass=()
for name in PATH XDG_CONFIG_HOME XDG_STATE_HOME PAIR_HUB_HOST PAIR_HUB_PORT; do
  if [ -n "${!name+set}" ]; then
    pass+=("$name=${!name}")
  fi
done
set -- env "${pass[@]}" "$@"

if [ -n "$TMUX" ] && tmux list-sessions >/dev/null 2>&1; then
  exec ws tab "$dir" -- "$@"
fi

# ws picks tmux whenever TMUX is set, so a stopped server's TMUX goes.
if [ -n "$REX_SESSION" ] && rex --autostart=false session inspect "$REX_SESSION" >/dev/null 2>&1; then
  exec env -u TMUX ws tab "$dir" -- "$@"
fi

# Terminal opens a .command file in a new window and runs it. The file
# deletes itself as it starts.
file=$(mktemp "${TMPDIR:-/tmp}/pair-spawn-XXXXXX")
mv "$file" "$file.command"
file=$file.command
{
  printf '#!/bin/bash\nrm -f %q\ncd %q || exit\nexec' "$file" "$dir"
  printf ' %q' "$@"
  printf '\n'
} >"$file"
chmod 700 "$file"
exec open -a Terminal "$file"
