#!/usr/bin/env zsh
# Sketchybar configuration
# Floating rounded bar, in the theme's colors (colors.sh)
#
# Layout:
# - Left: Date, Aerospace workspace indicators (V B N M)
# - Right: CPU, Memory, WiFi, Battery, Clock

setopt ERR_EXIT NO_UNSET PIPE_FAIL

# -----------------------------------------------------------------------------
# Configuration Paths
# -----------------------------------------------------------------------------
CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# Load color definitions (sources the rendered theme colors)
source "$CONFIG_DIR/colors.sh"

# -----------------------------------------------------------------------------
# Bar Configuration
# -----------------------------------------------------------------------------
# The bar's window is transparent. The rounded bar you see is the bracket
# at the end of this file, whose own shadow draws a faint line under it.
# macOS's window shadow is only on or off, and too strong on a light
# desktop. The window is 8 pixels taller than the bracket, so the line has
# room, and it sits 4 pixels higher, so the bracket stays 10 from the top.
bar=(
  position=top
  height=40
  margin=10
  color=0x00000000
  shadow=off
  sticky=on
  topmost=off
  y_offset=6
  padding_left=0
  padding_right=0
  notch_width=0
)
sketchybar --bar "${bar[@]}"

# -----------------------------------------------------------------------------
# Default Item Configuration
# -----------------------------------------------------------------------------
default=(
  padding_left=4
  padding_right=4
  background.height=26
  background.corner_radius=6
  icon.font="JetBrainsMono Nerd Font:Bold:12.0"
  icon.color="$ICON_COLOR"
  icon.padding_left=0
  icon.padding_right=6
  label.font="JetBrainsMono Nerd Font:Regular:12.0"
  label.color="$LABEL_COLOR"
  label.padding_left=0
  label.padding_right=12
)
sketchybar --default "${default[@]}"

# -----------------------------------------------------------------------------
# Custom Events (must be defined before items subscribe to them)
# -----------------------------------------------------------------------------
sketchybar --add event aerospace_workspace_change
sketchybar --add event agent_attention_change
sketchybar --add event review_attention_change
# macOS posts this whenever its appearance changes, from System Settings
# or anywhere else, and `theme` points every app at the new mode. sketchybar
# also runs every script once when it loads, and `theme` reloads sketchybar,
# so the script acts only on the appearance event.
sketchybar --add event appearance_change AppleInterfaceThemeChangedNotification

sketchybar --add item theme_sync left \
  --set theme_sync \
  drawing=off \
  script='[ "$SENDER" = appearance_change ] && theme' \
  --subscribe theme_sync appearance_change

# -----------------------------------------------------------------------------
# Date (Left - far left, before workspaces)
#
# label.padding_right overrides the 12px default, which is meant for the
# right-hand readouts where labels have to clear each other. Here it would
# only push the first workspace letter away from the date it sits beside.
#
# The bar has no padding, so the bracket reaches its ends, and the date and
# the clock hold the 24-pixel inset themselves.
# -----------------------------------------------------------------------------
sketchybar --add item date left \
  --set date \
  update_freq=60 \
  padding_left=24 \
  icon="󰃭 " \
  icon.color="$ACCENT_COLOR" \
  label.color="$ACCENT_COLOR" \
  label.padding_right=4 \
  background.color="$ITEM_BG" \
  script="$PLUGIN_DIR/date.sh" \
  --subscribe date system_woke

# -----------------------------------------------------------------------------
# Aerospace Workspace Indicators (Left)
# -----------------------------------------------------------------------------
# Display keybinding letters matching aerospace.toml keybindings
# Using zsh associative array (works in zsh 5.9)
# Keys align with bottom row (V B N M) and match monitor layout
# left-to-right. The on-demand stack workspace has no indicator — it is
# transient by design.
typeset -A WORKSPACE_KEYS
WORKSPACE_KEYS=(
  message "V" # mail/messages (left monitor)
  browser "B" # center monitor
  code "N"    # center monitor
  meeting "M" # Teams meetings (right monitor)
)

# The workspace list is shared with plugins/aerospace.sh, which repaints
# these items; it lives in one file so the two cannot disagree.
source "$CONFIG_DIR/workspaces.sh"

for workspace in "${WORKSPACES[@]}"; do
  key="${WORKSPACE_KEYS[$workspace]}"
  sketchybar --add item "space.$workspace" left \
    --set "space.$workspace" \
    icon="$key" \
    icon.font="JetBrainsMono Nerd Font:Bold:11.0" \
    icon.padding_left=8 \
    icon.padding_right=8 \
    label.drawing=off \
    background.color="$WORKSPACE_INACTIVE_BG" \
    background.corner_radius=6 \
    background.height=22 \
    click_script="aerospace workspace $workspace"
done

# One invisible item owns the repaint of every letter above. If each letter
# ran its own copy of the plugin, two events close together, such as the
# focus bouncing between monitors, would race: whichever process finished
# last would win per letter, and two letters would stay lit.
sketchybar --add item workspace_sync left \
  --set workspace_sync \
  drawing=off \
  script="$PLUGIN_DIR/aerospace.sh" \
  --subscribe workspace_sync aerospace_workspace_change

# The agent-attention letter: not an aerospace workspace, but it wears the
# same shape because it answers the same question — where should I look.
# It is its own letter, so "an agent needs you" never reads as "this is
# where your terminal lives", which the code workspace's letter says.
# cmd-alt-a walks through the agents, the one that wants you first.
sketchybar --add item space.agent left \
  --set space.agent \
  icon="A" \
  icon.font="JetBrainsMono Nerd Font:Bold:11.0" \
  icon.padding_left=8 \
  icon.padding_right=8 \
  label.drawing=off \
  background.color="$WORKSPACE_INACTIVE_BG" \
  background.corner_radius=6 \
  background.height=22 \
  script="$PLUGIN_DIR/agent.sh" \
  --subscribe space.agent agent_attention_change

# The review letter, beside the agent one because it answers the neighbouring
# question: an agent wants you versus GitHub wants you. Alt-R in Rex or tmux
# opens the Reviews popup.
sketchybar --add item space.review left \
  --set space.review \
  icon="R" \
  icon.font="JetBrainsMono Nerd Font:Bold:11.0" \
  icon.padding_left=8 \
  icon.padding_right=8 \
  label.drawing=off \
  background.color="$WORKSPACE_INACTIVE_BG" \
  background.corner_radius=6 \
  background.height=22 \
  script="$PLUGIN_DIR/review.sh" \
  --subscribe space.review review_attention_change

# -----------------------------------------------------------------------------
# Right Side Items (ordered right-to-left)
# -----------------------------------------------------------------------------

# Clock (rightmost) - time with clock icon
# Highlights in peach at meeting reminder times (00, 29, 30, 59 minutes):
# the fixed palette peach, deliberately not the notify color - see
# plugins/clock.sh
sketchybar --add item clock right \
  --set clock \
  update_freq=15 \
  icon="󰥔" \
  icon.font="JetBrainsMono Nerd Font:Bold:14.0" \
  label.font="JetBrainsMono Nerd Font:Bold:12.0" \
  background.color="$ITEM_BG" \
  script="$PLUGIN_DIR/clock.sh" \
  padding_right=24 \
  label.padding_right=0 \
  --subscribe clock system_woke

# Battery
sketchybar --add item battery right \
  --set battery \
  update_freq=60 \
  label.padding_right=8 \
  background.color="$ITEM_BG" \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery power_source_change system_woke

# WiFi - clickable, opens the Network settings pane
sketchybar --add item wifi right \
  --set wifi \
  update_freq=30 \
  background.color="$ITEM_BG" \
  script="$PLUGIN_DIR/wifi.sh" \
  click_script='open "x-apple.systempreferences:com.apple.Network-Settings.extension"' \
  --subscribe wifi wifi_change

# Memory (with icon)
sketchybar --add item memory right \
  --set memory \
  update_freq=10 \
  icon="󰍛" \
  icon.font="JetBrainsMono Nerd Font:Bold:14.0" \
  background.color="$ITEM_BG" \
  script="$PLUGIN_DIR/memory.sh"

# CPU (with icon)
sketchybar --add item cpu right \
  --set cpu \
  update_freq=5 \
  icon="󰌢" \
  icon.font="JetBrainsMono Nerd Font:Bold:14.0" \
  background.color="$ITEM_BG" \
  script="$PLUGIN_DIR/cpu.sh"

# -----------------------------------------------------------------------------
# The Bar You See
# -----------------------------------------------------------------------------
# A bracket around every item, from the date to the clock. Its shadow is a
# copy of its shape 2 pixels lower, with no blur.
sketchybar --add bracket bar_background '/.*/' \
  --set bar_background \
  background.color="$BAR_COLOR" \
  background.height=32 \
  background.corner_radius=10 \
  background.border_color="$BORDER_COLOR" \
  background.border_width=1 \
  background.shadow.drawing=on \
  background.shadow.color="$BAR_SHADOW" \
  background.shadow.distance=2 \
  background.shadow.angle=90

# -----------------------------------------------------------------------------
# Force Initial Update
# -----------------------------------------------------------------------------
sketchybar --update
