#!/bin/sh
# What would the editor's squiggles say? Runs a real headless Neovim session
# over the targets and reports every diagnostic. All logic lives in the Lua
# file next to this launcher; this shim only turns flags into ED_* variables,
# because a +luafile script has no argv of its own.
#
#   editor-diagnostics [target ...]        files or directories (default .)
#     --json PATH          also write a JSON report
#     --min-severity SEV   show only SEV and above (ERROR|WARN|INFO|HINT)
#     --fail-on SEV        exit 1 when findings at or above SEV exist
#     --timeout SECS       total budget across batches (default 120)
#
# Exit codes: 0 verified, 1 --fail-on triggered, 2 could not verify
# (no server attached, diagnostics never settled, or bad usage).
set -eu

# Resolve through this script's own symlink. macOS's readlink has no -f flag,
# so keep this portable across macOS and Linux.
SCRIPT_PATH="$0"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(CDPATH='' cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  case "$LINK_TARGET" in
  /*) SCRIPT_PATH="$LINK_TARGET" ;;
  *) SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"

targets=''
ED_JSON=''
ED_MIN_SEVERITY=''
ED_FAIL_ON=''
ED_TIMEOUT=''

while [ "$#" -gt 0 ]; do
  case "$1" in
  --json)
    ED_JSON="$2"
    shift 2
    ;;
  --min-severity)
    ED_MIN_SEVERITY="$2"
    shift 2
    ;;
  --fail-on)
    ED_FAIL_ON="$2"
    shift 2
    ;;
  --timeout)
    ED_TIMEOUT="$2"
    shift 2
    ;;
  -h | --help)
    sed -n '2,15p' "$SCRIPT_PATH" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  --*)
    echo "editor-diagnostics: unknown option: $1" >&2
    exit 2
    ;;
  *)
    targets="${targets}${1}
"
    shift
    ;;
  esac
done

ED_TARGETS="$targets"
export ED_TARGETS ED_JSON ED_MIN_SEVERITY ED_FAIL_ON ED_TIMEOUT
exec nvim --headless "+luafile $SCRIPT_DIR/editor-diagnostics.lua"
