#!/bin/bash
# Proves nvim-diagnostics against seeded failures — run it whenever you
# doubt the tool. Needs the machine's real language servers (ty, ruff,
# lua_ls), so like ci/editor-parity.lua it cannot run in CI.
# The whole file is "run a condition, hand check() its $?" — that's the
# assertion idiom here, not an accident.
# shellcheck disable=SC2319
set -u
pass=0
fail=0

# name, then 0/1 from the preceding test
check() {
  if [ "$2" -eq 0 ]; then
    pass=$((pass + 1))
    echo "PASS  $1"
  else
    fail=$((fail + 1))
    echo "FAIL  $1"
  fi
}

W="$(mktemp -d)"
trap 'rm -rf "$W"' EXIT

mkdir -p "$W/pyproj" && cd "$W/pyproj" && git init -q .
printf 'def f(x: int) -> str:\n    return x\n' >type_error.py
printf 'def broken(:\n' >syntax_error.py
printf 'x: int = 1\n' >clean.py

out="$(nvim-diagnostics type_error.py 2>/dev/null)"
rc=$?
echo "$out" | grep -q "ERROR ty" && [ $rc -eq 0 ]
check "single-file ty type error found, exit 0" $?
nvim-diagnostics type_error.py --fail-on ERROR >/dev/null 2>&1
[ $? -eq 1 ]
check "--fail-on ERROR exits 1" $?
out="$(nvim-diagnostics type_error.py --min-severity ERROR 2>/dev/null)"
! echo "$out" | grep -q "WARN"
check "--min-severity ERROR hides warnings" $?
nvim-diagnostics type_error.py --json "$W/report.json" >/dev/null 2>&1
jq -e '.summary.ERROR >= 1' "$W/report.json" >/dev/null 2>&1
check "--json writes a report with errors counted" $?
out="$(nvim-diagnostics clean.py 2>/dev/null)"
rc=$?
echo "$out" | grep -q "^0 findings" && [ $rc -eq 0 ] && ! echo "$out" | grep -q "NOT fully"
check "clean file verifies clean, exit 0" $?

mkdir -p "$W/luaproj" && cd "$W/luaproj" && git init -q .
printf 'local x = totally_undefined_fn()\nreturn x\n' >bad.lua
nvim-diagnostics bad.lua 2>/dev/null | grep -q "Undefined global"
check "lua_ls undefined global found" $?

# The sweep class: 51 files, seeded errors, gitignore, agreement with
# single-file runs. This is the shape that once false-cleaned.
B="$W/bigproj" && mkdir -p "$B/pkg" && cd "$B" && git init -q .
for i in $(seq 1 48); do printf 'def func_%d(x: int) -> int:\n    return x + %d\n' "$i" "$i" >"pkg/mod_$i.py"; done
printf 'def broken(:\n' >pkg/syntax_err.py
printf 'def g(x: int) -> str:\n    return x\n' >pkg/type_err.py
printf 'y = undefined_name_xyz\n' >pkg/name_err.py
mkdir -p ignored_dir && printf 'also broken(((\n' >ignored_dir/hidden_err.py && printf 'ignored_dir/\n' >.gitignore
out="$(nvim-diagnostics . 2>/dev/null)"
rc=$?
echo "$out" | grep -q "syntax_err.py"
check "sweep: syntax error found across 51 files" $?
echo "$out" | grep -q "type_err.py.*ERROR ty"
check "sweep: ty type error found" $?
echo "$out" | grep -q "name_err.py"
check "sweep: undefined name found" $?
! echo "$out" | grep -q "hidden_err"
check "sweep: gitignored file excluded" $?
! echo "$out" | grep -q "NOT fully verified" && [ $rc -eq 0 ]
check "sweep: fully verified, exit 0" $?
single="$(nvim-diagnostics pkg/type_err.py 2>/dev/null | grep -c "type_err")"
swept="$(echo "$out" | grep -c "type_err")"
[ "$single" -eq "$swept" ]
check "sweep agrees with single-file run" $?

echo
echo "RESULT: $pass passed, $fail failed"
[ $fail -eq 0 ]
