[user]
	name = Ryan Saxe
	email = ryancsaxe+1@gmail.com
[core]
	pager = delta --side-by-side --syntax-theme=tokyonight_night
	editor = nvim
	autocrlf = input
[push]
	default = simple
	autoSetupRemote = true
[pull]
	rebase = true
[branch]
	autosetuprebase = always
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	unstage = reset HEAD --
	last = log -1 HEAD
	visual = !gitk
	lg = log --oneline --graph --decorate --all
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
[status]
	showUntrackedFiles = all
[split-diffs]
	theme-directory = /Users/a10889158/.config/git/themes
	theme-name = git-diff-tokyonight
