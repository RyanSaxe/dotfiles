[user]
	name = Ryan Saxe
	email = ryancsaxe+1@gmail.com
[core]
	pager = hunk pager
	editor = nvim
	autocrlf = input
[push]
	default = simple
	autoSetupRemote = true
[pull]
	rebase = true
[branch]
	autosetuprebase = always
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	unstage = reset HEAD --
	last = log -1 HEAD
	visual = !gitk
	lg = log --oneline --graph --decorate --all
	ddiff = -c core.pager=\"delta --side-by-side --syntax-theme=tokyonight_night\" diff
	dshow = -c core.pager=\"delta --side-by-side --syntax-theme=tokyonight_night\" show
	hwatch = !hunk diff --watch
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[diff]
	tool = codediff
[difftool "codediff"]
	cmd = nvim -c \"CodeDiff file $LOCAL $REMOTE\"
[merge]
	tool = codediff
	conflictStyle = zdiff3
[mergetool "codediff"]
	cmd = nvim -c \"CodeDiff merge $MERGED\"
	trustExitCode = true
[status]
	showUntrackedFiles = all
[split-diffs]
	theme-directory = /Users/a10889158/.config/git/themes
	theme-name = git-diff-tokyonight
