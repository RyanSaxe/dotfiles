#!/bin/sh
# Account-wide GitHub attention observer.
#
# The refresh worker is intentionally separate from tmux, Neovim, and the
# rail renderer. launchd invokes `attention refresh` every five minutes on
# macOS; the other commands are useful for diagnostics and local testing.
set -eu

PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

# macOS's /usr/bin/readlink has no -f flag. Resolve the deployed symlink with
# POSIX readlink/cd so launchd and an interactive shell behave identically.
SCRIPT_PATH="$0"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(CDPATH='' cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  case "$LINK_TARGET" in
  /*) SCRIPT_PATH="$LINK_TARGET" ;;
  *) SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET" ;;
  esac
done
SCRIPT_DIR="$(CDPATH='' cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
REPO_ROOT="${SCRIPT_DIR%/tuis/rail/bin}"
RAIL_DIR="$REPO_ROOT/tuis/rail"

if [ -f "$REPO_ROOT/.env" ]; then
  set -a
  # shellcheck source=/dev/null
  . "$REPO_ROOT/.env"
  set +a
fi

cd "$RAIL_DIR"
# Bundled dist by default (a ~30ms node boot instead of the ~1s npx tsx
# cold start); RAIL_RUN=tsx flips back to running the TypeScript source.
if [ "${RAIL_RUN:-}" = tsx ]; then
  exec npx tsx src/attention/cli.ts "$@"
fi
# Rebuild when any source is newer than the build stamp — bin/rail's
# ensure_built, inlined — so launchd never runs a stale bundle.
if [ ! -f dist/.stamp ] || [ -n "$(find src -newer dist/.stamp -print -quit)" ]; then
  npm run --silent build
fi
exec node "$RAIL_DIR/dist/attention/cli.mjs" "$@"
