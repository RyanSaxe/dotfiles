#!/bin/sh
# Toggle the agent rail: reserve or release ghostty's left padding and flip
# the flag file hammerspoon watches. SIGUSR2 is ghostty's config-reload
# signal — the padding change regrids the terminal, and tmux/nvim reflow
# exactly as they would for a window resize.
set -eu

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
FLAG="$STATE/rail-on"
PAD_FILE="$HOME/.config/ghostty/padding.conf"
# rail column width (256) + gap to the text grid
RAIL_PAD=276

reload_ghostty() {
  pkill -USR2 -x ghostty 2>/dev/null || true
}

on() {
  # balance=false is required: the main config balances padding, which would
  # redistribute the asymmetric reservation evenly across both sides.
  printf 'window-padding-x = %s,20\nwindow-padding-balance = false\n' "$RAIL_PAD" >"$PAD_FILE"
  mkdir -p "$STATE" && touch "$FLAG"
  reload_ghostty
}

off() {
  printf 'window-padding-x = 20\n' >"$PAD_FILE"
  rm -f "$FLAG"
  reload_ghostty
}

case "${1:-toggle}" in
on) on ;;
off) off ;;
toggle) if [ -e "$FLAG" ]; then off; else on; fi ;;
status) [ -e "$FLAG" ] && echo on || echo off ;;
*)
  echo "usage: rail on|off|toggle|status" >&2
  exit 1
  ;;
esac
